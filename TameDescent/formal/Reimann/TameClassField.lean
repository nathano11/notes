import Reimann.Transfer

namespace Reimann.TameClassField

open Reimann.Transfer

/-- To apply this to a number field, supply its Artin map with the prescribed
kernel and prove surjectivity. The same interface models ordinary to S-ideal classes. -/
structure ArtinQuotient (G : GroupLaw A) (H : GroupLaw B) where
  proj : Hom G H
  onto : ∀ b, ∃ a, proj.app a = b

variable {G : GroupLaw A} {H : GroupLaw B} {R : GroupLaw C}

def KillsKernel (q : ArtinQuotient G H) (χ : Hom G R) : Prop :=
  ∀ a, q.proj.app a = H.zero → χ.app a = R.zero

theorem constant_on_fibers (q : ArtinQuotient G H) (χ : Hom G R) (hk : KillsKernel q χ)
    {a b : A} (he : q.proj.app a = q.proj.app b) : χ.app a = χ.app b := by
  have h0 := hk (G.add a (G.neg b)) (by rw [q.proj.preserves_add, q.proj.preserves_neg, he, H.add_neg])
  rw [χ.preserves_add, χ.preserves_neg] at h0
  have hh := congrArg (fun x => R.add x (χ.app b)) h0
  simpa only [R.assoc, R.neg_add, R.add_zero, R.zero_add] using hh

noncomputable def representative (q : ArtinQuotient G H) (b : B) : A :=
  Classical.choose (q.onto b)

theorem representative_projects (q : ArtinQuotient G H) (b : B) :
    q.proj.app (representative q b) = b := Classical.choose_spec (q.onto b)

noncomputable def descend (q : ArtinQuotient G H) (χ : Hom G R) (hk : KillsKernel q χ) :
    Hom H R where
  app b := χ.app (representative q b)
  preserves_zero := (constant_on_fibers q χ hk ((representative_projects q H.zero).trans
    q.proj.preserves_zero.symm)).trans χ.preserves_zero
  preserves_add b c := by
    rw [← χ.preserves_add]
    apply constant_on_fibers q χ hk
    rw [representative_projects, q.proj.preserves_add, representative_projects, representative_projects]
  preserves_neg b := by
    rw [← χ.preserves_neg]
    apply constant_on_fibers q χ hk
    rw [representative_projects, q.proj.preserves_neg, representative_projects]

theorem descend_projects (q : ArtinQuotient G H) (χ : Hom G R) (hk : KillsKernel q χ)
    (a : A) : (descend q χ hk).app (q.proj.app a) = χ.app a :=
  constant_on_fibers q χ hk (representative_projects q (q.proj.app a))

theorem descent_unique (q : ArtinQuotient G H) (ψ φ : Hom H R)
    (h : ∀ a, ψ.app (q.proj.app a) = φ.app (q.proj.app a)) : ψ = φ := by
  have hh : ψ.app = φ.app := funext (fun b => by
    obtain ⟨a,ha⟩ := q.onto b
    rw [← ha]
    exact h a)
  cases ψ
  cases φ
  simp_all

theorem factor_iff_kills_kernel (q : ArtinQuotient G H) (χ : Hom G R) :
    KillsKernel q χ ↔ ∃ ψ : Hom H R, (∀ a, ψ.app (q.proj.app a) = χ.app a) ∧
      ∀ φ : Hom H R, (∀ a, φ.app (q.proj.app a) = χ.app a) → φ = ψ := by
  constructor
  · intro hk
    refine ⟨descend q χ hk, descend_projects q χ hk, ?_⟩
    intro φ hφ
    exact descent_unique q φ (descend q χ hk) (fun a => (hφ a).trans (descend_projects q χ hk a).symm)
  · rintro ⟨ψ,hψ,_⟩ a ha
    rw [← hψ, ha, ψ.preserves_zero]

theorem descended_equivariance (q : ArtinQuotient G H) (χ : Hom G R) (hk : KillsKernel q χ)
    (up : A → A) (down : B → B) (twist : C → C)
    (hproj : ∀ a, q.proj.app (up a) = down (q.proj.app a))
    (hχ : ∀ a, χ.app (up a) = twist (χ.app a)) (b : B) :
    (descend q χ hk).app (down b) = twist ((descend q χ hk).app b) := by
  obtain ⟨a,rfl⟩ := q.onto b
  rw [← hproj, descend_projects, descend_projects, hχ]

/-- Canonical integer representatives of Z/m with the genuine additive group law. -/
def residueGroup (m : Int) : GroupLaw {x : Int // x % m = x} where
  zero := ⟨0, by simp⟩
  add x y := ⟨(x.val+y.val) % m, by simp⟩
  neg x := ⟨(-x.val) % m, by simp⟩
  assoc a b c := by apply Subtype.ext; simp [Int.add_assoc]
  zero_add a := by apply Subtype.ext; simpa using a.property
  add_zero a := by apply Subtype.ext; simpa using a.property
  add_neg a := by apply Subtype.ext; simp [show a.val + -a.val = 0 by omega]
  neg_add a := by apply Subtype.ext; simp [show -a.val + a.val = 0 by omega]

theorem unit_difference_fixed_zero (m u v w x : Int)
    (hu : (u-1)*v + m*w = 1) (hfixed : (u*x) % m = x % m) : x % m = 0 := by
  obtain ⟨k,hk⟩ := Int.dvd_of_emod_eq_zero (Int.emod_eq_emod_iff_emod_sub_eq_zero.mp hfixed)
  apply Int.emod_eq_zero_of_dvd
  refine ⟨v*k+w*x, ?_⟩
  have h1 := congrArg (fun a : Int => a*x) hu
  have h2 := congrArg (fun a : Int => v*a) hk
  grind

theorem kills_fixed_prime (m u v w : Int) (χ : Hom G (residueGroup m)) (σ : A → A)
    (hu : (u-1)*v + m*w = 1) (heq : ∀ a, (χ.app (σ a)).val = (u*(χ.app a).val) % m)
    (a : A) (hfix : σ a = a) : χ.app a = (residueGroup m).zero := by
  apply Subtype.ext
  have h := heq a
  rw [hfix] at h
  have hx := (χ.app a).property
  exact hx.symm.trans (unit_difference_fixed_zero m u v w (χ.app a).val hu (h.symm.trans hx.symm))

/-- Elements generated by a specified family of classes, with ordinary additive closure. -/
inductive Generated (G : GroupLaw A) (S : A → Prop) : A → Prop where
  | of_mem {x} : S x → Generated G S x
  | zero : Generated G S G.zero
  | add {x y} : Generated G S x → Generated G S y → Generated G S (G.add x y)
  | neg {x} : Generated G S x → Generated G S (G.neg x)

theorem kills_generated (χ : Hom G R) {S : A → Prop} (hS : ∀ x, S x → χ.app x = R.zero)
    {a : A} (ha : Generated G S a) : χ.app a = R.zero := by
  induction ha with
  | of_mem h => exact hS _ h
  | zero => exact χ.preserves_zero
  | add _ _ hx hy => rw [χ.preserves_add, hx, hy, R.zero_add]
  | @neg x _ hx =>
    have h := χ.preserves_add x (G.neg x)
    rw [G.add_neg, χ.preserves_zero, hx, R.zero_add] at h
    exact h.symm

theorem kills_tame_class_kernel (q : ArtinQuotient G H) (m : Int)
    (χ : Hom G (residueGroup m)) (S : A → Prop)
    (hker : ∀ a, q.proj.app a = H.zero → Generated G S a)
    (htame : ∀ a, S a → ∃ (σ : A → A) (u v w : Int), σ a = a ∧
      (u-1)*v + m*w = 1 ∧ ∀ x, (χ.app (σ x)).val = (u*(χ.app x).val) % m) :
    KillsKernel q χ := by
  intro a ha
  apply kills_generated χ _ (hker a ha)
  intro x hx
  obtain ⟨σ,u,v,w,hfix,hu,heq⟩ := htame x hx
  exact kills_fixed_prime m u v w χ σ hu heq x hfix

/-- Ordinary characters factor uniquely through the S-class quotient under the
explicit prime-generation and tame stabilizer hypotheses. Each prime can have a
different stabilizer. The number-field quotient map and these hypotheses are inputs. -/
theorem ordinary_to_S_unique (q : ArtinQuotient G H) (m : Int)
    (χ : Hom G (residueGroup m)) (S : A → Prop)
    (hker : ∀ a, q.proj.app a = H.zero → Generated G S a)
    (htame : ∀ a, S a → ∃ (σ : A → A) (u v w : Int), σ a = a ∧
      (u-1)*v + m*w = 1 ∧ ∀ x, (χ.app (σ x)).val = (u*(χ.app x).val) % m) :
    ∃ ψ : Hom H (residueGroup m), (∀ a, ψ.app (q.proj.app a) = χ.app a) ∧
      ∀ φ : Hom H (residueGroup m), (∀ a, φ.app (q.proj.app a) = χ.app a) → φ = ψ :=
  (factor_iff_kills_kernel q χ).mp (kills_tame_class_kernel q m χ S hker htame)

end Reimann.TameClassField
