import Reimann2893.SignedCyclotomicEmbedding2893
import Reimann.SignedGammaTower
import Mathlib.RingTheory.RootsOfUnity.Complex

/-! The layers inside the complex numbers, using the standard primitive dyadic roots. -/
namespace Reimann.SignedComplexLayers2893

open Reimann.SignedFieldLayers2893 Reimann.SignedCyclotomicTrace2893
open Reimann.SignedCyclotomicEmbedding2893

noncomputable def zeta (n : ℕ) : ℂ :=
  Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (2:ℂ)^(n+2))

theorem primitive (n : ℕ) : IsPrimitiveRoot (zeta n) (2^(n+2)) := by
  simpa only [zeta, Nat.cast_pow, Nat.cast_ofNat] using
    Complex.isPrimitiveRoot_exp (2^(n+2)) (pow_ne_zero _ (by decide))

theorem zeta_initial : zeta 0 ^ 2 = -1 := by
  rw [zeta, pow_two, ← Complex.exp_add, ← Complex.exp_pi_mul_I]
  congr 1
  ring

theorem zeta_square (n : ℕ) : zeta (n+1)^2 = zeta n := by
  rw [zeta, zeta, pow_two, ← Complex.exp_add]
  congr 1
  rw [show n+1+2=(n+2)+1 by omega, pow_succ]
  field_simp
  ring

noncomputable def imaginaryRadical : ℂ := Complex.I * (Real.sqrt 2893 : ℝ)

theorem imaginaryRadical_sq : imaginaryRadical^2 = -2893 := by
  rw [imaginaryRadical, mul_pow, Complex.I_sq, ← Complex.ofReal_pow,
    Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 2893)]
  norm_num

noncomputable def complexRoots : Roots ℂ where
  radical := imaginaryRadical
  radical_sq := imaginaryRadical_sq
  zeta := zeta
  nonzero _ := Complex.exp_ne_zero _
  initial := zeta_initial
  square := zeta_square

/-- The image is precisely the subfield generated by the two conventional generators of kₙ. -/
theorem layer_is_cyclotomic (n : ℕ) :
    (embedding complexRoots n).fieldRange =
      Subfield.closure {imaginaryRadical, realTrace (zeta n)} :=
  image_generated complexRoots n

/-- In the standard complex realization the checked automorphism acts by the forward power five. -/
theorem forward_is_cyclotomic (n : ℕ) :
    embedding complexRoots n (forward n (traceRoot n)) = realTrace (zeta n ^ 5) :=
  image_forward_trace complexRoots n

theorem powers_on_trace (n j : ℕ) :
    embedding complexRoots n ((forward n ^ j) (traceRoot n)) = realTrace (zeta n ^ (5^j)) := by
  induction j with
  | zero =>
    simp only [pow_zero,pow_one,RingAut.one_apply]
    exact embedding_trace complexRoots n
  | succ j ih =>
    rw [pow_succ (forward n), RingAut.mul_apply, forward_five, pow_succ (5:ℕ),
      pow_mul, forward_trace (zeta n ^ (5^j)) (pow_ne_zero _ (complexRoots.nonzero n))]
    simp only [map_add,map_sub,map_mul,map_pow,map_ofNat,ih]

theorem power_mod_order (n a : ℕ) : zeta n ^ a = zeta n ^ (a % 2^(n+2)) := by
  calc
    _ = zeta n ^ (a % 2^(n+2) + 2^(n+2)*(a/2^(n+2))) :=
      congrArg (fun j => zeta n ^ j) (Nat.mod_add_div a _).symm
    _ = _ := by rw [pow_add,pow_mul,(primitive n).pow_eq_one,one_pow,mul_one]

/-- The arithmetic inverse representative acts on the forward image of the
root of unity by undoing its exponent. The reflected representative yields
the inverse root, which has the same real trace. -/
theorem inverse_fibres_on_forward_root (n j : ℕ) :
    let w := zeta n ^ (5^j)
    let t := SignedGammaTower.representative n j
    w ^ t = zeta n ∧ w ^ (2^(n+2)-t) = (zeta n)⁻¹ := by
  dsimp only
  have hp : (zeta n ^ 5^j)^(SignedGammaTower.representative n j) = zeta n := by
    rw [←pow_mul,power_mod_order,SignedGammaTower.representative_is_inverse,pow_one]
  refine ⟨hp,?_⟩
  apply (mul_eq_one_iff_eq_inv₀ (show zeta n ≠ 0 from complexRoots.nonzero n)).mp
  conv_lhs => rhs; rw [←hp]
  rw [←pow_add, Nat.sub_add_cancel (Nat.le_of_lt (SignedGammaTower.representative_lt n j))]
  rw [←pow_mul,Nat.mul_comm,pow_mul,(primitive n).pow_eq_one,one_pow]

end Reimann.SignedComplexLayers2893
