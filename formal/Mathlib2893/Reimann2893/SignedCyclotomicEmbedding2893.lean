import Reimann2893.SignedFieldLayers2893
import Reimann2893.SignedCyclotomicTrace2893
import Mathlib.Algebra.Field.Subfield.Basic

/-! Realize each quadratic layer inside a common field and identify its image
with the subfield generated by the imaginary radical and a cyclotomic trace. -/
namespace Reimann.SignedCyclotomicEmbedding2893

open Reimann.SignedFieldLayers2893 Reimann.SignedCyclotomicTrace2893

variable {F : Type*} [Field F] [CharZero F]

structure Roots (F : Type*) [Field F] where
  radical : F
  radical_sq : radical^2 = -2893
  zeta : ℕ → F
  nonzero : ∀ n, zeta n ≠ 0
  initial : zeta 0 ^ 2 = -1
  square : ∀ n, zeta (n+1)^2 = zeta n

noncomputable def realization (r : Roots F) :
    (n : ℕ) → { i : Layer n →+* F // i (traceRoot n) = realTrace (r.zeta n) }
  | 0 => ⟨liftBottom r.radical r.radical_sq, by
      rw [traceRoot_zero, map_zero, trace_zero _ (r.nonzero 0) r.initial]⟩
  | n+1 =>
    let prev := realization r n
    let u := realTrace (r.zeta (n+1))
    have square : u^2 = prev.val (2+traceRoot n) := by
      rw [map_add, map_ofNat, prev.property]
      exact compatible_traces r.zeta r.nonzero r.square n
    ⟨liftNext n prev.val u square, liftNext_root n prev.val u square⟩

noncomputable def embedding (r : Roots F) (n : ℕ) : Layer n →+* F :=
  (realization r n).val

theorem embedding_trace (r : Roots F) (n : ℕ) :
    embedding r n (traceRoot n) = realTrace (r.zeta n) := (realization r n).property

theorem embedding_include (r : Roots F) (n : ℕ) (x : Layer n) :
    embedding r (n+1) (includeNext n x) = embedding r n x :=
  liftNext_include n (embedding r n) _ (by
    rw [map_add, map_ofNat, embedding_trace]
    exact compatible_traces r.zeta r.nonzero r.square n) x

theorem embedding_radical (r : Roots F) (n : ℕ) :
    embedding r n (embedBottom n bottomRadical) = r.radical := by
  induction n with
  | zero => exact liftBottom_radical r.radical r.radical_sq
  | succ n ih => exact (embedding_include r n _).trans ih

theorem image_forward_trace (r : Roots F) (n : ℕ) :
    embedding r n (forward n (traceRoot n)) = realTrace (r.zeta n ^ 5) := by
  rw [forward_five, forward_trace _ (r.nonzero n)]
  simp only [map_add, map_sub, map_mul, map_pow, map_ofNat, embedding_trace]

theorem image_mem (r : Roots F) (S : Subfield F) (hs : r.radical ∈ S) (n : ℕ)
    (ht : realTrace (r.zeta n) ∈ S) (x : Layer n) : embedding r n x ∈ S := by
  induction n with
  | zero =>
    change algebraMap ℚ F (x : Bottom).re + algebraMap ℚ F (x : Bottom).im * r.radical ∈ S
    exact S.add_mem (SubfieldClass.ratCast_mem S _) (S.mul_mem (SubfieldClass.ratCast_mem S _) hs)
  | succ n ih =>
    have down : realTrace (r.zeta n) ∈ S := by
      have id := compatible_traces r.zeta r.nonzero r.square n
      have es : realTrace (r.zeta n) = realTrace (r.zeta (n+1))^2 - 2 := by rw [id]; ring
      rw [es]
      exact S.sub_mem (S.pow_mem ht 2) (natCast_mem S 2)
    obtain ⟨a,b,h⟩ := span_next n x
    rw [h,map_add,map_mul,embedding_include,embedding_include,embedding_trace]
    exact S.add_mem (ih down a) (S.mul_mem (ih down b) ht)

theorem image_generated (r : Roots F) (n : ℕ) :
    (embedding r n).fieldRange = Subfield.closure {r.radical, realTrace (r.zeta n)} := by
  apply le_antisymm
  · rintro _ ⟨x,rfl⟩
    exact image_mem r _ (Subfield.subset_closure (by simp)) n
      (Subfield.subset_closure (by simp)) x
  · apply Subfield.closure_le.mpr
    intro x hx
    rcases hx with h | h
    · change x = r.radical at h
      exact ⟨_,(embedding_radical r n).trans h.symm⟩
    · change x = realTrace (r.zeta n) at h
      exact ⟨_,(embedding_trace r n).trans h.symm⟩

end Reimann.SignedCyclotomicEmbedding2893
