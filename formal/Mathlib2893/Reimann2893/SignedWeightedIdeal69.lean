import Reimann2893.SignedNativeSeries2893

/-! The two orientations of the conductor-69 ideal comparison modulo the
third power of the ideal generated by two and the power series variable. -/
namespace Reimann.SignedWeightedIdeal69

open SignedNativeScalar2893 SignedNativeSeries2893 PowerSeries
open DyadicSeriesProjection

theorem reverse_weighted_bits (x y a b c : BitVec 3)
    (hx : x.setWidth 1 = 0) (hy : y.setWidth 1 = 0)
    (h0 : 4 = a*x) (h1 : (2:BitVec 2) = (a*y+b*x).setWidth 2)
    (h2 : (1:BitVec 1) = (a+(b*y+c*x)).setWidth 1) :
    x=4 ∧ y.setWidth 2=2 :=
  (by decide : ∀ x y a b c : BitVec 3, x.setWidth 1=0 → y.setWidth 1=0 →
    4=a*x → (2:BitVec 2)=(a*y+b*x).setWidth 2 →
    (1:BitVec 1)=(a+(b*y+c*x)).setWidth 1 → x=4 ∧ y.setWidth 2=2) x y a b c hx hy h0 h1 h2

theorem cube_expansion {R : Type*} [CommRing R] (a b : R) :
    (Ideal.span {a,b})^3 = Ideal.span {a^3,a^2*b,a*b^2,b^3} := by
  simp only [Ideal.span_insert, ← Ideal.add_eq_sup, pow_succ, pow_zero, one_mul,
    add_mul, mul_add, Ideal.span_singleton_mul_span_singleton]
  simp only [Ideal.add_eq_sup, mul_comm, mul_left_comm]
  simp [sup_assoc, sup_left_comm]

noncomputable abbrev maximalIdeal : Ideal (PowerSeries ℤ_[2]) := Ideal.span {2, X}

theorem cube_coefficients (z : PowerSeries ℤ_[2]) (hz : z ∈ maximalIdeal^3) :
    ∃ a b c : ℤ_[2], coeff 0 z=8*a ∧ coeff 1 z=4*b ∧ coeff 2 z=2*c := by
  rw [maximalIdeal, cube_expansion] at hz
  obtain ⟨f, u, hu, rfl⟩ := Ideal.mem_span_insert.mp hz
  obtain ⟨g, v, hv, rfl⟩ := Ideal.mem_span_insert.mp hu
  obtain ⟨h, w, hw, rfl⟩ := Ideal.mem_span_insert.mp hv
  obtain ⟨i,rfl⟩ := Ideal.mem_span_singleton.mp hw
  have form : f * 2^3 + (g * (2^2*X) + (h * (2*X^2) + X^3*i)) =
      C (8:ℤ_[2])*f + C (4:ℤ_[2])*(g*X^1) + C (2:ℤ_[2])*(h*X^2) + i*X^3 := by
    simp only [map_ofNat, pow_one]
    ring
  rw [form]
  refine ⟨coeff 0 f, 2*coeff 1 f + coeff 0 g, 4*coeff 2 f + 2*coeff 1 g + coeff 0 h, ?_⟩
  simp only [map_add, coeff_C_mul, coeff_mul_X_pow']
  norm_num
  constructor <;> ring

def jet (s : Series) : BitVec 3 × BitVec 2 × BitVec 1 :=
  ((s 0).residue 2, (s 1).residue 1, (s 2).residue 0)

theorem jet_words (s : Series) : jet s =
    ((s 0).residue 2, ((s 1).residue 2).setWidth 2, ((s 2).residue 2).setWidth 1) := by
  rw [(s 1).reduce (by decide : 1≤2), (s 2).reduce (by decide : 0≤2)]
  rfl

theorem jet_add_cube (f z : PowerSeries ℤ_[2]) (hz : z ∈ maximalIdeal^3) :
    jet (readSeries (f+z)) = jet (readSeries f) := by
  obtain ⟨a,b,c,ha,hb,hc⟩ := cube_coefficients _ hz
  simp only [jet,readSeries,map_add,ha,hb,hc,read_add,read_mul,read_nat,DyadicLattice.add,
    DyadicLattice.mul,DyadicLattice.natScalar]
  rfl

theorem weighted_product (u v : Series) : jet (convolution u v) =
    ((u 0).residue 2*(v 0).residue 2,
     ((u 0).residue 2*(v 1).residue 2 + (u 1).residue 2*(v 0).residue 2).setWidth 2,
     ((u 0).residue 2*(v 2).residue 2 +
       ((u 1).residue 2*(v 1).residue 2 + (u 2).residue 2*(v 0).residue 2)).setWidth 1) := by
  rw [jet_words, convolution_zero, convolution_one, convolution_two]

theorem jet_of_membership (f g : PowerSeries ℤ_[2]) (h : f ∈ Ideal.span {g} + maximalIdeal^3) :
    ∃ u : Series, jet (readSeries f) = jet (convolution u (readSeries g)) := by
  obtain ⟨y,hy,z,hz,rfl⟩ := Submodule.mem_sup.mp h
  obtain ⟨u,rfl⟩ := Ideal.mem_span_singleton.mp hy
  refine ⟨readSeries u,?_⟩
  rw [jet_add_cube _ _ hz, mul_comm g, readSeries_mul]

theorem canonical_weighted : jet DyadicMahler69.series=(4,2,1) := by
  obtain ⟨c,l,q⟩ := DyadicOneSided69.canonical_jet
  rw [jet_words,c,l,q]
  decide

/-- A distinguished quadratic dividing the candidate in the native weighted
quotient already has the constant and linear residues for the two samples. -/
theorem samples_of_reverse_cube (c0 c1 : ℤ_[2])
    (even0 : PadicInt.toZModPow 1 c0=0) (even1 : PadicInt.toZModPow 1 c1=0)
    (h : candidate69 ∈ Ideal.span {quadratic c0 c1} + maximalIdeal^3) :
    DyadicOrder.WeightOneSamples (read c0) (read c1) := by
  obtain ⟨u,hu⟩ := jet_of_membership _ _ h
  rw [read_candidate69,canonical_weighted,read_quadratic,weighted_product] at hu
  obtain ⟨h0,h12⟩ := Prod.mk.inj hu
  obtain ⟨h1,h2⟩ := Prod.mk.inj h12
  change (1:BitVec 1) = ((u 0).residue 2*1 + ((u 1).residue 2*(read c1).residue 2 +
    (u 2).residue 2*(read c0).residue 2)).setWidth 1 at h2
  simp only [BitVec.mul_one] at h2
  obtain ⟨r0,r1⟩ := reverse_weighted_bits ((read c0).residue 2) ((read c1).residue 2)
    ((u 0).residue 2) ((u 1).residue 2) ((u 2).residue 2)
    (((read c0).reduce (by decide : 0≤2)).trans (read_even c0 even0))
    (((read c1).reduce (by decide : 0≤2)).trans (read_even c1 even1)) h0 h1 h2
  exact DyadicClass69.sample_bits_of_coefficients _ _ r0
    (((read c1).reduce (by decide : 1≤2)).symm.trans r1)

/-- The opposite orientation of the same native cube comparison also suffices. -/
theorem samples_of_forward_cube (c0 c1 : ℤ_[2])
    (h : quadratic c0 c1 ∈ Ideal.span {candidate69} + maximalIdeal^3) :
    DyadicOrder.WeightOneSamples (read c0) (read c1) := by
  obtain ⟨u,hu⟩ := jet_of_membership _ _ h
  rw [read_quadratic,read_candidate69,weighted_product] at hu
  obtain ⟨z,l,q⟩ := DyadicOneSided69.canonical_jet
  rw [z,l,q,BitVec.mul_one] at hu
  apply (DyadicOneSided69.weighted_jet_iff_samples _ _).mp
  exact ⟨(u 0).residue 2,(u 1).residue 2,(u 2).residue 2,hu⟩

end Reimann.SignedWeightedIdeal69
