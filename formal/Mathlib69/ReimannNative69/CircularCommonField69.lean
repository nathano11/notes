import ReimannNative69.CommonConjugation69
import ReimannNative69.CommonRealPart69
import ReimannNative69.CommonRootPowers69
import ReimannNative69.CircularOrbitFamily69
import ReimannNative69.CircularSubgroup69
import Reimann.CircularQuotientCoordinate69

/-! The exponent-zero circular unit in the common conductor-19113 field. -/
namespace Reimann.CircularCommonField69

open CircularFieldReduction69 CircularPolynomial69 CircularSinnott69 CircularRealUnit69
  CircularSubgroup69 CircularFieldNorm69

abbrev K := CommonAmbient69.K
noncomputable abbrev x : K := CommonAmbient69.x
noncomputable abbrev u : K := CircularRadicals69.radical3 x
noncomputable abbrev v : K := CircularRadicals69.radical23 x
noncomputable abbrev c : Conjugation K := CommonConjugation69.conjugation

theorem radical_values : u^2 = -3 ∧ v^2 = -23 ∧
    u*v = 2*CircularFactor69.periodTheta x-1 :=
  CircularRadicals69.primitive_radicals x CommonAmbient69.x_primitive.order69
    CommonAmbient69.x_primitive.not23 CommonAmbient69.x_primitive.not3

noncomputable def realField : Subfield K := CommonRealPart69.realCompositum c u v

theorem real_field_generators :
    realField = Subfield.closure (CommonRealPart69.threeGenerators u v CommonAmbient69.z) ⊓
      CommonRealPart69.fixedField c :=
  CommonRealPart69.fixed_three_generator_field c u v CommonAmbient69.z CommonAmbient69.z_order
    (fun _ hz => CommonRootPowers69.root_is_power CommonAmbient69.z_order CommonAmbient69.z_nontrivial hz)

theorem real_membership (y : K) : y ∈ realField ↔ RealPart c u v y :=
  CommonRealPart69.mem_realCompositum_iff c u v y

theorem real_predicate : (fun y : K => y ∈ realField) = RealPart c u v :=
  funext (fun y => propext (real_membership y))

/-- Circular numbers generated by the intersection norms at divisors of 19113. -/
noncomputable def numberGroup : Subgroup Kˣ :=
  CircularOrbitFamily69.circularNumbers (fun n => n ∣ 19113) (fun y => y ∈ realField)

theorem conductor_norms_in_group :
    normGenerators x CommonAmbient69.x_primitive (RealPart c u v) ⊆ numberGroup := by
  unfold numberGroup
  rw [real_predicate]
  rintro w ⟨a, ha, hw⟩
  exact CircularOrbitFamily69.norm_factor_mem CircularOrbitFamily69.conductor_divisor x
    CommonAmbient69.x_primitive (RealPart c u v) a ha w hw

noncomputable def integerOrder : Subring K := realIntegerOrder c u v

noncomputable def circularUnitGroup : Subgroup integerOrderˣ :=
  circularUnits integerOrder numberGroup

theorem norm_operator_factorization :
    ∃ reps : List (Fin 69), (∀ a ∈ reps, eta a.val = 1) ∧
      signedProduct x 1 = reps.foldr (fun a s =>
        normOperator x CommonAmbient69.x_primitive (fun y => y ∈ realField) (factor x a) * s) 1 := by
  rw [real_predicate]
  exact (real_circular_unit x u v CommonAmbient69.x_primitive radical_values.1 radical_values.2.1
    c CommonConjugation69.compatible).1

theorem positive_is_relative_norm : signedProduct x 1 =
    CircularRationalPeriod69.evaluate (CircularFactor69.periodTheta x)
      (relativeNorm x (1-x) CommonAmbient69.x_primitive.order69 CommonAmbient69.x_primitive.not23
        CommonAmbient69.x_primitive.not3 (one_sub_mem x)) :=
  CircularNorm69.positive_product_eq_relative_norm x CommonAmbient69.x_primitive.order69
    CommonAmbient69.x_primitive.not23 CommonAmbient69.x_primitive.not3

theorem signed_inverse_value : 25 - signedProduct x 1 = signedProduct x 276 := by
  have ht := norm_products_trace x (CircularPrimitive69.phi_vanishes_of_order69 x
    CommonAmbient69.x_primitive.order69 CommonAmbient69.x_primitive.not23 CommonAmbient69.x_primitive.not3)
  exact sub_eq_iff_eq_add.mpr (ht.symm.trans (add_comm _ _))

theorem labelled_coordinates (a : Fin 277) :
    ((49063 : Fin 114679)^a.val = reduction CommonAmbient69.x_primitive
      (orderPow (signedUnit x 1) 414) ↔ a = 159) ∧
    ((49063 : Fin 114679)^a.val = reduction CommonAmbient69.x_primitive
      (orderPow (CircularQuotientCoordinate69.quotientInOrder x) 414) ↔ a = 41) :=
  ⟨positive_log_coordinate CommonAmbient69.x_primitive a,
    CircularQuotientCoordinate69.quotient_coordinate CommonAmbient69.x_primitive a⟩

/-- The same unit in any specified ring of integers and group of circular
numbers whose field and conductor generators agree with this realization. -/
theorem transport_to_specified_subgroup (O : Subring K) (D : Subgroup Kˣ)
    (hO : ∀ y : K, y ∈ realField → IsIntegral ℤ y → y ∈ O)
    (hD : normGenerators x CommonAmbient69.x_primitive (fun y => y ∈ realField) ⊆ D) :
    ∃ w : Oˣ, ((w : O) : K) = signedProduct x 1 ∧ ((w⁻¹).val : K) = signedProduct x 276 ∧
      w ∈ circularUnits O D ∧ w⁻¹ ∈ circularUnits O D := by
  rw [real_predicate] at hD
  obtain ⟨w, he, hf, hw, hi⟩ := positive_and_inverse_in_integers x u v CommonAmbient69.x_primitive
    radical_values.1 radical_values.2.1 c CommonConjugation69.compatible O D
    (fun y hy => hO y ((real_membership y).mpr hy)) hD
  exact ⟨w, he, hf.trans signed_inverse_value, hw, hi⟩

/-- The two signed norm products are inverse integral units in the named
conductor-divisor circular-unit subgroup of this real compositum. -/
theorem canonical_real_specialization :
    ∃ w : integerOrderˣ, ((w : integerOrder) : K) = signedProduct x 1 ∧
      ((w⁻¹).val : K) = signedProduct x 276 ∧
      w ∈ circularUnitGroup ∧ w⁻¹ ∈ circularUnitGroup := by
  obtain ⟨w, he, hf, hw, hi⟩ := positive_and_inverse_in_real_integer_order x u v
    CommonAmbient69.x_primitive radical_values.1 radical_values.2.1 c CommonConjugation69.compatible
    numberGroup conductor_norms_in_group
  exact ⟨w, he, hf.trans signed_inverse_value, hw, hi⟩

end Reimann.CircularCommonField69
