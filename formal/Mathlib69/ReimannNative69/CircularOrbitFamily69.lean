import Mathlib.Algebra.Field.Basic
import Mathlib.Algebra.CharP.Basic
import Mathlib.Algebra.Group.Subgroup.Lattice
import Reimann.CircularSinnott69

/-! Circular numbers with a specified set of conductors. The orbit of a
primitive root is restricted to substitutions fixing every rational
polynomial value in the target field. -/
namespace Reimann.CircularOrbitFamily69

open CircularFieldReduction69 CircularPolynomialField69 CircularRelationEval69
  CircularMonomial69 CircularSinnott69 CircularCosets69 CircularSubstitution69
  CircularPowerSubstitution69

variable {R : Type} [Field R] [CharZero R]

def PrimitiveAt (n : Nat) (z : R) : Prop :=
  z^n = 1 ∧ Function.Injective (fun a : Fin n => z^a.val)

theorem primitive_at_69 {x : R} (hx : Primitive69 x) : PrimitiveAt 69 x :=
  ⟨hx.order69, fun a b => CircularRootOrbit69.power_injective x hx.order69 hx.not23 hx.not3 a b⟩

def fixesIntersectionAt {n : Nat} (z : R) (K : R → Prop) (s : Fin n) : Prop :=
  Nat.Coprime s.val n ∧ ∀ (p : Nat → Rat) (m : Nat), Bounded p m →
    K (evalAt z p m) → evalAt (z^s.val) p m = evalAt z p m

theorem fixes_at_69_iff (x : R) (hx : Primitive69 x) (K : R → Prop) (s : Fin 69) :
    fixesIntersectionAt x K s ↔ intersectionLabels x hx K s := by
  constructor
  · rintro ⟨hs, hfix⟩
    refine ⟨hs, ?_⟩
    intro y hy
    obtain ⟨p,m,hp,he⟩ := y.property
    apply Subtype.ext
    rw [power_automorphism_eval x hx s hs y p m he]
    exact (hfix p m hp (he.symm ▸ hy)).trans he
  · rintro ⟨hs, hfix⟩
    refine ⟨hs, ?_⟩
    intro p m hp hy
    let y : Carrier x := ⟨evalAt x p m, p, m, hp, rfl⟩
    exact (power_automorphism_eval x hx s hs y p m rfl).symm.trans
      (congrArg Subtype.val (hfix y hy))

noncomputable def orbitAt {n : Nat} (z : R) (K : R → Prop) (a : Fin n) : R := by
  classical
  exact ((List.finRange n).filter (fun s => decide (fixesIntersectionAt z K s))).foldr
    (fun s v => (1 - (z^a.val)^s.val) * v) 1

theorem orbit_at_69 (x : R) (hx : Primitive69 x) (K : R → Prop) (a : Fin 69) :
    orbitAt x K a = normOperator x hx K (factor x a) := by
  classical
  rw [factor_orbit, orbit_as_power_product x hx.order69]
  have h := labels_ext (fixesIntersectionAt x K) (intersectionLabels x hx K)
    (fixes_at_69_iff x hx K)
  exact congrArg (fun ss : List (Fin 69) => ss.foldr (fun s v => (1-(x^a.val)^s.val)*v) 1) h

/-- The multiplicative subgroup generated by -1 and the labelled
intersection-norm products for every permitted conductor. -/
def circularNumbers (permitted : Nat → Prop) (K : R → Prop) : Subgroup Rˣ :=
  Subgroup.closure {w | (w : R) = -1 ∨ ∃ (n : Nat) (_ : 1 < n) (_ : permitted n)
    (z : R) (_ : PrimitiveAt n z) (a : Fin n), Nat.Coprime a.val n ∧ (w : R) = orbitAt z K a}

theorem norm_factor_mem {permitted : Nat → Prop} (h69 : permitted 69) (x : R)
    (hx : Primitive69 x) (K : R → Prop) (a : Fin 69) (ha : Nat.Coprime a.val 69)
    (w : Rˣ) (hw : (w : R) = normOperator x hx K (factor x a)) :
    w ∈ circularNumbers permitted K := by
  apply Subgroup.subset_closure
  exact Or.inr ⟨69, by decide, h69, x, primitive_at_69 hx, a, ha, hw.trans (orbit_at_69 x hx K a).symm⟩

theorem conductor_divisor : 69 ∣ 19113 := by decide

end Reimann.CircularOrbitFamily69
