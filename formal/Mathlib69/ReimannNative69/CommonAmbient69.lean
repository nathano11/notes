import ReimannNative69.ConcreteQuotient69

/-! A common characteristic-zero field generated by a primitive 19113th root.
First adjoin a primitive 277th root to the concrete conductor-69 field. -/
namespace Reimann.CommonAmbient69

open Polynomial
open CircularFieldReduction69
abbrev Base := ConcreteQuotient69.K

open CircularAmbient69 (geometric geometric_identity)

theorem map_geometric {A B : Type} [CommRing A] [CommRing B]
    (f : A →+* B) (a : A) (n : Nat) : f (geometric a n) = geometric (f a) n := by
  induction n with
  | zero => exact f.map_zero
  | succ n ih => simp only [geometric, map_add, map_one, map_mul, ih]

theorem geometric_one {A : Type} [CommRing A] (n : Nat) :
    geometric (1 : A) n = n := by
  induction n with
  | zero => simp [geometric]
  | succ n ih => simp only [geometric, one_mul, ih, Nat.cast_succ, add_comm]

theorem geometric_zero {A : Type} [CommRing A] (n : Nat) :
    geometric (0 : A) (n+1) = 1 := by simp only [geometric, zero_mul, add_zero]

noncomputable def definingPolynomial : Base[X] := geometric X 277

theorem evaluate_defining (a : Base) :
    Polynomial.evalRingHom a definingPolynomial = geometric a 277 := by
  rw [definingPolynomial, map_geometric]
  simp

theorem defining_nonunit : ¬ IsUnit definingPolynomial := by
  intro h
  obtain ⟨b, _, hb⟩ := Polynomial.isUnit_iff.mp h
  have eq : geometric (0 : Base) 277 = geometric (1 : Base) 277 := by
    rw [← evaluate_defining, ← evaluate_defining, ← hb]
    simp
  rw [geometric_zero 276, geometric_one] at eq
  exact (by decide : ¬ (1 : Nat) = 277)
    (CharZero.cast_injective (R := Base) (by simpa only [Nat.cast_one] using eq))

theorem maximal_ideal_exists :
    ∃ M : Ideal Base[X], M.IsMaximal ∧ definingPolynomial ∈ M := by
  have hp : Ideal.span {definingPolynomial} ≠ ⊤ :=
    fun h => defining_nonunit (Ideal.span_singleton_eq_top.mp h)
  obtain ⟨M, hm, hle⟩ := Ideal.exists_le_maximal _ hp
  exact ⟨M, hm, hle (Ideal.subset_span (Set.mem_singleton _))⟩

noncomputable def chosenIdeal : Ideal Base[X] := maximal_ideal_exists.choose

theorem chosen_maximal : chosenIdeal.IsMaximal := maximal_ideal_exists.choose_spec.1

theorem defining_mem : definingPolynomial ∈ chosenIdeal := maximal_ideal_exists.choose_spec.2

abbrev K := Base[X] ⧸ chosenIdeal

noncomputable abbrev residueField : Field K := by
  letI : chosenIdeal.IsMaximal := chosen_maximal
  exact Ideal.Quotient.field chosenIdeal

attribute [instance] residueField

noncomputable def quotientMap : Base[X] →+* K := Ideal.Quotient.mk chosenIdeal

noncomputable def baseEmbedding : Base →+* K := quotientMap.comp Polynomial.C

theorem baseEmbedding_injective : Function.Injective baseEmbedding := by
  intro a b heq
  by_contra hn
  have h : baseEmbedding ((a-b) * (a-b)⁻¹) = 0 := by
    rw [map_mul, map_sub, heq, sub_self, zero_mul]
  rw [mul_inv_cancel₀ (sub_ne_zero.mpr hn), map_one] at h
  exact one_ne_zero h

theorem characteristicZero : CharZero K where
  cast_injective := by
    intro a b h
    apply CharZero.cast_injective (R := Base)
    apply baseEmbedding_injective
    simpa only [map_natCast] using h

attribute [instance] characteristicZero

noncomputable def x : K := baseEmbedding ConcreteQuotient69.ζ

noncomputable def z : K := quotientMap X

theorem x_primitive : Primitive69 x := by
  constructor
  · rw [x, ← map_pow, ConcreteQuotient69.generator_pow_69, map_one]
  · intro h
    apply ConcreteQuotient69.generator_pow_23_ne_one
    exact baseEmbedding_injective (by simpa only [x, map_pow, map_one] using h)
  · intro h
    apply ConcreteQuotient69.generator_pow_three_ne_one
    exact baseEmbedding_injective (by simpa only [x, map_pow, map_one] using h)

theorem z_vanishes : geometric z 277 = 0 := by
  rw [z, ← map_geometric]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr defining_mem

theorem z_order : z^277 = 1 := by
  have h := geometric_identity z 277
  rw [z_vanishes, mul_zero] at h
  exact sub_eq_zero.mp h.symm

theorem z_nontrivial : z ≠ 1 := by
  intro h
  have hz := z_vanishes
  rw [h, geometric_one] at hz
  exact (by decide : ¬ (277 : Nat) = 0)
    (CharZero.cast_injective (R := K) (by simpa only [Nat.cast_zero] using hz))

noncomputable def root : K := x * z^273

theorem x_pow_277 : x^277 = x := by
  rw [show 277 = 69*4+1 by decide, pow_succ, pow_mul, x_primitive.order69, one_pow, one_mul]

theorem z_pow_18837 : z^18837 = z := by
  rw [show 18837 = 277*68+1 by decide, pow_succ, pow_mul, z_order, one_pow, one_mul]

theorem root_pow_277 : root^277 = x := by
  rw [root, mul_pow, x_pow_277, ← pow_mul, Nat.mul_comm 273 277, pow_mul, z_order, one_pow, mul_one]

theorem root_pow_69 : root^69 = z := by
  rw [root, mul_pow, x_primitive.order69, one_mul, ← pow_mul]
  exact z_pow_18837

theorem root_pow_19113 : root^19113 = 1 := by
  rw [show 19113 = 277*69 by decide, pow_mul, root_pow_277, x_primitive.order69]

theorem root_pow_6371_ne_one : root^6371 ≠ 1 := by
  rw [show 6371 = 277*23 by decide, pow_mul, root_pow_277]
  exact x_primitive.not23

theorem root_pow_831_ne_one : root^831 ≠ 1 := by
  rw [show 831 = 277*3 by decide, pow_mul, root_pow_277]
  exact x_primitive.not3

theorem root_pow_69_ne_one : root^69 ≠ 1 := by rw [root_pow_69]; exact z_nontrivial

/-- Evaluate a rational polynomial in the distinguished 19113th root. -/
noncomputable def rationalEvaluation : ℚ[X] →+* K :=
  eval₂RingHom (baseEmbedding.comp ConcreteQuotient69.rationalEmbedding) root

theorem evaluation_X : rationalEvaluation X = root := Polynomial.eval₂_X _ _

theorem evaluation_C (q : ℚ) :
    rationalEvaluation (C q) = baseEmbedding (ConcreteQuotient69.rationalEmbedding q) :=
  Polynomial.eval₂_C _ _

theorem base_monomial_in_range (n : Nat) (a : ℚ) :
    baseEmbedding (ConcreteQuotient69.quotientMap (monomial n a)) ∈ rationalEvaluation.range := by
  refine ⟨C a * (X^277)^n, ?_⟩
  rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow, map_pow, map_mul, map_pow]
  rw [evaluation_C, evaluation_X, root_pow_277]
  rfl

theorem base_in_range (a : Base) : baseEmbedding a ∈ rationalEvaluation.range := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  change baseEmbedding (ConcreteQuotient69.quotientMap p) ∈ _
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add, map_add]; exact rationalEvaluation.range.add_mem hp hq
  | monomial n a => exact base_monomial_in_range n a

theorem z_in_range : z ∈ rationalEvaluation.range := by
  exact ⟨X^69, by rw [map_pow, evaluation_X, root_pow_69]⟩

theorem monomial_in_range (n : Nat) (a : Base) :
    quotientMap (monomial n a) ∈ rationalEvaluation.range := by
  rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow]
  exact rationalEvaluation.range.mul_mem (base_in_range a) (rationalEvaluation.range.pow_mem z_in_range n)

theorem rational_polynomial_surjective : Function.Surjective rationalEvaluation := by
  intro a
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  change quotientMap p ∈ rationalEvaluation.range
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [map_add]; exact rationalEvaluation.range.add_mem hp hq
  | monomial n a => exact monomial_in_range n a

noncomputable instance rationalAlgebra : Algebra ℚ K :=
  (baseEmbedding.comp ConcreteQuotient69.rationalEmbedding).toAlgebra

theorem rationalEvaluation_eq :
    rationalEvaluation = Polynomial.eval₂RingHom (algebraMap ℚ K) root := by
  have h : baseEmbedding.comp ConcreteQuotient69.rationalEmbedding = algebraMap ℚ K :=
    RingHom.ext_rat _ _
  rw [rationalEvaluation, h]

/-- Two periods of a multiplicative element give their gcd as a period. -/
theorem power_gcd (u : K) (a b : Nat) (ha : u^a = 1) (hb : u^b = 1) :
    u^(a.gcd b) = 1 := by
  by_cases h : a = 0
  · subst a; simpa using hb
  · rw [Nat.gcd_rec]
    apply power_gcd u (b%a) a _ ha
    have he := congrArg (fun k : Nat => u^k) (Nat.mod_add_div b a)
    simpa only [pow_add, pow_mul, ha, one_pow, mul_one, hb] using he
termination_by a
decreasing_by exact Nat.mod_lt _ (Nat.pos_of_ne_zero h)

theorem z_dvd_of_power (n : Nat) (h : z^n = 1) : 277 ∣ n := by
  have hg := power_gcd z n 277 h z_order
  have prime : Nat.Prime 277 := by set_option maxRecDepth 4096 in decide +kernel
  rcases (Nat.dvd_prime prime).mp (Nat.gcd_dvd_right n 277) with one | same
  · rw [one, pow_one] at hg
    exact (z_nontrivial hg).elim
  · exact Nat.gcd_eq_right_iff_dvd.mp same

theorem x_dvd_of_power (n : Nat) (h : x^n = 1) : 69 ∣ n := by
  apply Nat.dvd_of_mod_eq_zero
  by_contra hn
  have he := CircularKernel69.power_period x x_primitive.order69 n
  exact CircularRootOrbit69.nonzero_power_ne_one x x_primitive.order69 x_primitive.not23
    x_primitive.not3 ⟨n%69, Nat.mod_lt _ (by decide)⟩ hn (he.symm.trans h)

theorem root_order_iff (n : Nat) : root^n = 1 ↔ 19113 ∣ n := by
  constructor
  · intro h
    have hx : x^n = 1 := by rw [← root_pow_277, pow_right_comm, h, one_pow]
    have hz : z^n = 1 := by rw [← root_pow_69, pow_right_comm, h, one_pow]
    exact (by decide : Nat.Coprime 69 277).mul_dvd_of_dvd_of_dvd
      (x_dvd_of_power n hx) (z_dvd_of_power n hz)
  · rintro ⟨d, rfl⟩
    rw [pow_mul, root_pow_19113, one_pow]

end Reimann.CommonAmbient69

