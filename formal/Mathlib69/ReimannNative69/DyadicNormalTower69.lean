import Mathlib.FieldTheory.Galois.GaloisClosure
import Mathlib.Algebra.AlgebraicCard
import Mathlib.Data.Rat.Encodable
import Reimann.DyadicGenusField69

/-! A cofinal sequence of finite normal subextensions in a countable
algebraic Galois field, with prescribed cyclotomic generators. -/
namespace Reimann.DyadicNormalTower69

variable (K Ω : Type*) [Field K] [Field Ω] [Algebra K Ω] [IsGalois K Ω]

/-- The finite normal field generated by the enumerated element and the
specified root from this level. -/
noncomputable def block (x z : Ω) : FiniteGaloisIntermediateField K Ω :=
  FiniteGaloisIntermediateField.adjoin K {x} ⊔ FiniteGaloisIntermediateField.adjoin K {z}

noncomputable def stages (u ζ : ℕ → Ω) : ℕ → FiniteGaloisIntermediateField K Ω
  | 0 => block K Ω (u 0) (ζ 0)
  | n+1 => stages u ζ n ⊔ block K Ω (u (n+1)) (ζ (n+1))

theorem stages_mono (u ζ : ℕ → Ω) : Monotone (stages K Ω u ζ) :=
  monotone_nat_of_le_succ (fun _ => le_sup_left)

theorem block_le_stage (u ζ : ℕ → Ω) (n : ℕ) :
    block K Ω (u n) (ζ n) ≤ stages K Ω u ζ n := by
  cases n with
  | zero => exact le_rfl
  | succ n => exact le_sup_right

theorem mem_stage (u ζ : ℕ → Ω) (n : ℕ) :
    u n ∈ (stages K Ω u ζ n).toIntermediateField ∧
    ζ n ∈ (stages K Ω u ζ n).toIntermediateField :=
  ⟨FiniteGaloisIntermediateField.adjoin_simple_le_iff.mp
      (le_trans le_sup_left (block_le_stage K Ω u ζ n)),
    FiniteGaloisIntermediateField.adjoin_simple_le_iff.mp
      (le_trans le_sup_right (block_le_stage K Ω u ζ n))⟩

theorem stages_exhaust (u ζ : ℕ → Ω) (hu : Function.Surjective u) (x : Ω) :
    ∃ n, x ∈ (stages K Ω u ζ n).toIntermediateField := by
  obtain ⟨n,rfl⟩ := hu x
  exact ⟨n,(mem_stage K Ω u ζ n).1⟩

theorem stages_cofinal (u ζ : ℕ → Ω) (hu : Function.Surjective u)
    (S : IntermediateField K Ω) [FiniteDimensional K S] :
    ∃ n, S ≤ (stages K Ω u ζ n).toIntermediateField := by
  obtain ⟨x,hx⟩ := Field.exists_primitive_element K S
  obtain ⟨n,hn⟩ := stages_exhaust K Ω u ζ hu (x : Ω)
  refine ⟨n,?_⟩
  let T := (stages K Ω u ζ n).toIntermediateField
  have hpre : IntermediateField.adjoin K {x} ≤ IntermediateField.comap S.val T :=
    IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hn)
  rw [hx,top_le_iff] at hpre
  intro a ha
  change (⟨a,ha⟩ : S) ∈ T.comap S.val
  rw [hpre]
  exact Set.mem_univ _

theorem extension_countable (k L : Type*) [Field k] [Field L] [Algebra k L]
    [Algebra.IsAlgebraic k L] [Countable k] : Countable L := by
  have h : ({x : L | IsAlgebraic k x} : Set L) = Set.univ :=
    Set.eq_univ_of_forall (fun x => Algebra.IsAlgebraic.isAlgebraic x)
  have hc := Algebraic.countable k L
  rw [h] at hc
  exact Set.countable_univ_iff.mp hc

/-- Every countable-base Galois extension admits an increasing cofinal
sequence of genuine finite Galois subextensions containing the prescribed
n-th element at level n. The lower fields of a cyclotomic tower can therefore
be included by choosing the sequence of roots of unity for ζ. -/
theorem cofinal_normal_tower [Countable K] (ζ : ℕ → Ω) :
    ∃ T : ℕ → FiniteGaloisIntermediateField K Ω, Monotone T ∧
      (∀ n, ζ n ∈ (T n).toIntermediateField) ∧
      (∀ x : Ω, ∃ n, x ∈ (T n).toIntermediateField) ∧
      ∀ (S : IntermediateField K Ω) [FiniteDimensional K S],
        ∃ n, S ≤ (T n).toIntermediateField := by
  let : Countable Ω := extension_countable K Ω
  obtain ⟨u,hu⟩ := exists_surjective_nat Ω
  exact ⟨stages K Ω u ζ, stages_mono K Ω u ζ, fun n => (mem_stage K Ω u ζ n).2,
    stages_exhaust K Ω u ζ hu, fun S _ => stages_cofinal K Ω u ζ hu S⟩

/-- Specialized to a number-field base using the two defining hypotheses
in characteristic zero. Countability follows from algebraicity over ℚ. -/
theorem number_field_cofinal_tower [CharZero K] [FiniteDimensional ℚ K] (ζ : ℕ → Ω) :
    ∃ T : ℕ → FiniteGaloisIntermediateField K Ω, Monotone T ∧
      (∀ n, ζ n ∈ (T n).toIntermediateField) ∧
      (∀ x : Ω, ∃ n, x ∈ (T n).toIntermediateField) ∧
      ∀ (S : IntermediateField K Ω) [FiniteDimensional K S],
        ∃ n, S ≤ (T n).toIntermediateField := by
  let : Countable K := extension_countable ℚ K
  exact cofinal_normal_tower K Ω ζ

/-- An automorphism of any lower intermediate field extends over this
upper finite normal stage, pointwise on the lower field. -/
theorem ordinary_stage_lift (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) (t : L ≃ₐ[K] L) :
    ∃ g : J ≃ₐ[K] J, ∀ x : L, g (x : J) = (t x : J) :=
  ⟨t.liftNormal J,t.liftNormal_commutes J⟩

/-- E_a = ℚ(√−3,√−23,ζ+ζ⁻¹) inside the chosen characteristic-zero field. -/
noncomputable def realLayer (L : Type*) [Field L] [CharZero L] (x y z : L) :
    IntermediateField ℚ L := IntermediateField.adjoin ℚ {x,y,z+z⁻¹}

theorem realLayer_finite (L : Type*) [Field L] [CharZero L] [Algebra.IsAlgebraic ℚ L]
    (x y z : L) : FiniteDimensional ℚ (realLayer L x y z) := by
  classical
  unfold realLayer
  exact IntermediateField.finiteDimensional_adjoin
    (fun v _ => (Algebra.IsAlgebraic.isAlgebraic (R:=ℚ) v).isIntegral)

/-- L = Eₐ(μ₂∞), generated by a choice of one primitive dyadic root per layer. -/
noncomputable def fullCyclotomic (L : Type*) [Field L] [CharZero L] (x y : L) (ζ : ℕ → L)
    (a : ℕ) : IntermediateField (realLayer L x y (ζ a)) L :=
  IntermediateField.adjoin _ (Set.range ζ)

theorem fullCyclotomic_normal (L : Type*) [Field L] [CharZero L] (x y : L) (ζ : ℕ → L)
    (a : ℕ) [Normal (realLayer L x y (ζ a)) L]
    (hz : ∀ n, (ζ n)^(2^(n+1) : ℕ) = -1) :
    Normal (realLayer L x y (ζ a)) (fullCyclotomic L x y ζ a) := by
  apply IntermediateField.normal_iff_forall_map_le.mpr
  intro σ
  unfold fullCyclotomic
  rw [IntermediateField.adjoin_map,IntermediateField.adjoin_le_iff]
  rintro _ ⟨_,⟨n,rfl⟩,rfl⟩
  have h := congrArg σ (hz n)
  have hσ : (σ (ζ n))^(2^(n+1) : ℕ) = -1 := by simpa only [map_pow,map_neg,map_one] using h
  have hs : (σ (ζ n))^(2^(n+1+1) : ℕ) = 1 := by
    rw [Nat.pow_succ,pow_mul,hσ]; simp
  obtain ⟨k,hk⟩ := DyadicGenusField69.powers_exhaust_roots (n+1) (ζ n) (σ (ζ n)) (hz n) hs
  rw [hk]
  exact pow_mem (IntermediateField.subset_adjoin (realLayer L x y (ζ a))
    (Set.range ζ) (Set.mem_range_self n)) k

/-- A cofinal finite normal tower over the actual displayed E_a in any
algebraic upper field which is Galois over E_a. -/
theorem real_layer_tower (L : Type*) [Field L] [CharZero L] [Algebra.IsAlgebraic ℚ L]
    (x y : L) (ζ : ℕ → L) (a : ℕ) [IsGalois (realLayer L x y (ζ a)) L] :
    ∃ T : ℕ → FiniteGaloisIntermediateField (realLayer L x y (ζ a)) L, Monotone T ∧
      (∀ n, ζ n ∈ (T n).toIntermediateField) ∧ (∀ e : L, ∃ n, e ∈ (T n).toIntermediateField) ∧
      ∀ (S : IntermediateField (realLayer L x y (ζ a)) L) [FiniteDimensional (realLayer L x y (ζ a)) S],
        ∃ n, S ≤ (T n).toIntermediateField := by
  let : Countable L := extension_countable ℚ L
  exact cofinal_normal_tower (realLayer L x y (ζ a)) L ζ

/-- ζ₀ is a primitive fourth root and each subsequent choice is a square root. -/
noncomputable def dyadicRoot (L : Type*) [Field L] [IsAlgClosed L] : ℕ → L
  | 0 => (IsAlgClosed.exists_pow_nat_eq (-1 : L) zero_lt_two).choose
  | n+1 => (IsAlgClosed.exists_pow_nat_eq (dyadicRoot L n) zero_lt_two).choose

theorem dyadicRoot_sq (L : Type*) [Field L] [IsAlgClosed L] (n : ℕ) :
    (dyadicRoot L (n+1))^2=dyadicRoot L n :=
  (IsAlgClosed.exists_pow_nat_eq (dyadicRoot L n) zero_lt_two).choose_spec

theorem dyadicRoot_half_order (L : Type*) [Field L] [IsAlgClosed L] (n : ℕ) :
    (dyadicRoot L n)^(2^(n+1) : ℕ) = -1 := by
  induction n with
  | zero => exact (IsAlgClosed.exists_pow_nat_eq (-1 : L) zero_lt_two).choose_spec
  | succ n ih => rw [Nat.pow_succ,Nat.mul_comm,pow_mul,dyadicRoot_sq,ih]

/-- In an actual algebraic closure of ℚ, the roots, the dyadic root tower
and the countable cofinal fields all exist for every starting real layer. -/
theorem absolute_real_layer_tower (L : Type*) [Field L] [CharZero L] [IsAlgClosure ℚ L] :
    ∃ x y : L, ∃ ζ : ℕ → L, x^2 = -3 ∧ y^2 = -23 ∧
      (∀ n, ζ (n+1)^2 = ζ n) ∧ (∀ n, (ζ n)^(2^(n+1) : ℕ) = -1) ∧
      ∀ a, ∃ T : ℕ → FiniteGaloisIntermediateField (realLayer L x y (ζ a)) L,
        Monotone T ∧ (∀ n, ζ n ∈ (T n).toIntermediateField) ∧
        (∀ e : L, ∃ n, e ∈ (T n).toIntermediateField) ∧
        ∀ (S : IntermediateField (realLayer L x y (ζ a)) L) [FiniteDimensional (realLayer L x y (ζ a)) S],
          ∃ n, S ≤ (T n).toIntermediateField := by
  let : IsAlgClosed L := IsAlgClosure.isAlgClosed ℚ
  obtain ⟨x,hx⟩ := IsAlgClosed.exists_pow_nat_eq (-3 : L) zero_lt_two
  obtain ⟨y,hy⟩ := IsAlgClosed.exists_pow_nat_eq (-23 : L) zero_lt_two
  exact ⟨x,y,dyadicRoot L,hx,hy,dyadicRoot_sq L,dyadicRoot_half_order L,fun a =>
    real_layer_tower L x y (dyadicRoot L) a⟩

/-- The actual finite kernel at a normal stage, enumerated without repetition. -/
noncomputable def relativeAutomorphisms (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) : List (J ≃ₐ[L] J) := Finset.univ.toList

theorem relative_enumeration (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) :
    (relativeAutomorphisms K Ω J L).Nodup ∧
      ∀ σ : J ≃ₐ[L] J, σ ∈ relativeAutomorphisms K Ω J L := by
  classical
  exact ⟨Finset.nodup_toList _,fun _ => Finset.mem_toList.mpr (Finset.mem_univ _)⟩

/-- The product of the relative conjugates of a field element lands in the
lower field. This is the orbit-norm hypothesis used by prime correction. -/
theorem relative_orbit_product (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) (x : J) :
    ∃ y : L, (y : J) = ((relativeAutomorphisms K Ω J L).map (fun σ => σ x)).prod := by
  classical
  rw [relativeAutomorphisms,Finset.prod_map_toList]
  apply (IsGalois.mem_range_algebraMap_iff_fixed (F:=L) (E:=J) _).mpr
  intro σ
  rw [map_prod]
  exact Fintype.prod_equiv (Equiv.mulLeft σ) _ _ (fun τ => rfl)

/-- Embed the enumerated relative Galois group into the upper Galois group. -/
noncomputable def kernelList (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) : List (J ≃ₐ[K] J) :=
  (relativeAutomorphisms K Ω J L).map (fun σ => σ.restrictScalars K)

theorem kernelList_identity (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) : 1 ∈ kernelList K Ω J L := by
  refine List.mem_map.mpr ⟨1,(relative_enumeration K Ω J L).2 _,?_⟩
  ext x
  rfl

theorem kernelList_fixes (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) {g : J ≃ₐ[K] J} (hg : g ∈ kernelList K Ω J L) (x : L) :
    g (x : J) = x := by
  obtain ⟨σ,_,rfl⟩ := List.mem_map.mp hg
  exact σ.commutes x

/-- Native field form of the finite prime-correction kernel norm. -/
theorem kernelList_norm (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) (x : J) :
    ∃ y : L, (y : J) = ((kernelList K Ω J L).map (fun σ => σ x)).prod := by
  simpa only [kernelList,List.map_map,Function.comp_def,AlgEquiv.restrictScalars_apply] using
    relative_orbit_product K Ω J L x

theorem orbit_integral (J : FiniteGaloisIntermediateField K Ω) (x : J)
    (hx : IsIntegral ℤ x) (gs : List (J ≃ₐ[K] J)) :
    IsIntegral ℤ ((gs.map (fun σ => σ x)).prod) := by
  induction gs with
  | nil => exact isIntegral_one
  | cons σ gs ih => exact (IsIntegral.map (A:=K) σ hx).mul ih

/-- An integral conjugate product comes from an integral lower-field element.
This supplies relative orbit-norm descent for the genuine integral orders. -/
theorem integral_kernel_norm (J : FiniteGaloisIntermediateField K Ω)
    (L : IntermediateField K J) (x : J) (hx : IsIntegral ℤ x) :
    ∃ y : L, IsIntegral ℤ y ∧ (y : J) = ((kernelList K Ω J L).map (fun σ => σ x)).prod := by
  obtain ⟨y,hy⟩ := kernelList_norm K Ω J L x
  refine ⟨y,?_,hy⟩
  apply (isIntegral_algebraMap_iff (R:=ℤ) (A:=L) (B:=J)).mp
  change IsIntegral ℤ (y : J)
  rw [hy]
  exact orbit_integral K Ω J x hx _

/-- A single ordinary extension supplies compatible lifts at every finite
normal stage. Pointwise equality in the ambient field expresses restriction
compatibility without choosing presentations for inclusions of stages. -/
theorem compatible_ordinary_lifts (S : IntermediateField K Ω) (t : S ≃ₐ[K] S)
    (T : ℕ → FiniteGaloisIntermediateField K Ω) :
    ∃ g : Ω ≃ₐ[K] Ω, ∃ f : ∀ n, T n ≃ₐ[K] T n,
      (∀ x : S, g (x : Ω) = (t x : Ω)) ∧
      (∀ n (x : T n), (f n x : Ω) = g (x : Ω)) ∧
      ∀ i j (x : T i) (y : T j), (x : Ω) = (y : Ω) → (f i x : Ω) = (f j y : Ω) := by
  let g := t.liftNormal Ω
  refine ⟨g,fun n => g.restrictNormal (T n),t.liftNormal_commutes Ω,
    fun n x => g.restrictNormal_commutes (T n) x,?_⟩
  intro i j x y hxy
  exact (g.restrictNormal_commutes (T i) x).trans
    ((congrArg g hxy).trans (g.restrictNormal_commutes (T j) y).symm)

/-- The normal closure used to enumerate the finite cyclotomic layer adds
nothing: every conjugate of the chosen primitive root is a power of it. -/
theorem finite_cyclotomic_stage (z : Ω) (n : ℕ) (hz : z^(2^(n+1) : ℕ) = -1) :
    (FiniteGaloisIntermediateField.adjoin K {z}).toIntermediateField =
      IntermediateField.adjoin K {z} := by
  change IntermediateField.normalClosure K (IntermediateField.adjoin K {z}) Ω = _
  apply IntermediateField.normal_iff_normalClosure_eq.mp
  apply IntermediateField.normal_iff_forall_map_le.mpr
  intro σ
  rw [IntermediateField.adjoin_map,Set.image_singleton,IntermediateField.adjoin_le_iff,
    Set.singleton_subset_iff]
  have hσ : (σ z)^(2^(n+1) : ℕ) = -1 := by
    simpa only [map_pow,map_neg,map_one] using congrArg σ hz
  have hs : (σ z)^(2^(n+1+1) : ℕ) = 1 := by
    rw [Nat.pow_succ,pow_mul,hσ]
    simp
  obtain ⟨k,hk⟩ := DyadicGenusField69.powers_exhaust_roots (n+1) z (σ z) hz hs
  rw [hk]
  exact pow_mem (IntermediateField.subset_adjoin K {z} (Set.mem_singleton z)) k

theorem finite_cyclotomic_mono (ζ : ℕ → Ω) (hs : ∀ n, (ζ (n+1))^2 = ζ n) :
    Monotone (fun n => FiniteGaloisIntermediateField.adjoin K {ζ n}) := by
  apply monotone_nat_of_le_succ
  intro n
  apply FiniteGaloisIntermediateField.adjoin_simple_le_iff.mpr
  rw [← hs n]
  exact pow_mem (FiniteGaloisIntermediateField.subset_adjoin K {ζ (n+1)}
    (Set.mem_singleton _)) 2

theorem finite_cyclotomic_sup (ζ : ℕ → Ω) (hz : ∀ n, (ζ n)^(2^(n+1) : ℕ) = -1) :
    (⨆ n, (FiniteGaloisIntermediateField.adjoin K {ζ n}).toIntermediateField) =
      IntermediateField.adjoin K (Set.range ζ) := by
  apply le_antisymm
  · apply iSup_le
    intro n
    rw [finite_cyclotomic_stage K Ω (ζ n) n (hz n)]
    exact IntermediateField.adjoin.mono K {ζ n} (Set.range ζ)
      (Set.singleton_subset_iff.mpr (Set.mem_range_self n))
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨n,rfl⟩
    exact (le_iSup (fun j => (FiniteGaloisIntermediateField.adjoin K {ζ j}).toIntermediateField) n)
      (FiniteGaloisIntermediateField.subset_adjoin K {ζ n} (Set.mem_singleton _))

/-- At every base Eₐ the finite lower stages are precisely Eₐ(ζ_n);
they exhaust Eₐ(μ₂∞) and are contained in the stipulated upper stages. -/
theorem finite_cyclotomic_stages (L : Type*) [Field L] [CharZero L] (x y : L) (ζ : ℕ → L)
    (a : ℕ) [IsGalois (realLayer L x y (ζ a)) L]
    (hs : ∀ n, (ζ (n+1))^2 = ζ n) (hz : ∀ n, (ζ n)^(2^(n+1) : ℕ) = -1)
    (T : ℕ → FiniteGaloisIntermediateField (realLayer L x y (ζ a)) L)
    (hT : ∀ n, ζ n ∈ (T n).toIntermediateField) :
    ∃ S : ℕ → FiniteGaloisIntermediateField (realLayer L x y (ζ a)) L,
      Monotone S ∧ (∀ n, S n ≤ T n) ∧
      (∀ n, (S n).toIntermediateField = IntermediateField.adjoin (realLayer L x y (ζ a)) {ζ n}) ∧
      (⨆ n, (S n).toIntermediateField) = fullCyclotomic L x y ζ a :=
  ⟨_,finite_cyclotomic_mono _ L ζ hs,fun n => FiniteGaloisIntermediateField.adjoin_simple_le_iff.mpr (hT n),
    fun n => finite_cyclotomic_stage _ L (ζ n) n (hz n),finite_cyclotomic_sup _ L ζ hz⟩

end Reimann.DyadicNormalTower69
