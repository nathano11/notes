def basisColumns (i j : Fin 44) : Int :=
  if j.val < 22 then (if i = j then 1 else 0)
  else (periodColumns[j.val - 22]?.getD #[])[i.val]?.getD 0

def inverseColumns (i j : Fin 44) : Int :=
  if j.val < 22 then (if i = j then 1 else 0)
  else (relativeColumns[j.val - 22]?.getD #[])[i.val]?.getD 0

theorem table_dimensions :
    periodColumns.size = 22 ∧ relativeColumns.size = 22 ∧
    periodColumns.all (fun c => c.size == 44) = true ∧
    relativeColumns.all (fun c => c.size == 44) = true := by
  decide +kernel

def columnPoly (j : Fin 44) : List Int := List.ofFn (fun i : Fin 44 => basisColumns i j)

def rawColumn (j : Fin 44) : List Int :=
  if j.val < 22 then List.replicate j.val 0 ++ [1]
  else List.replicate (j.val - 22) 0 ++ periodPoly

def columnDifference (j : Fin 44) : List Int :=
  add (rawColumn j) ((columnPoly j).map (fun c => (-1:Int) * c))

def matrixProduct (a b : Fin 44 → Fin 44 → Int) (i j : Fin 44) : Int :=
  (List.ofFn (fun k : Fin 44 => a i k * b k j)).sum

set_option maxRecDepth 10000
set_option maxHeartbeats 4000000

theorem column_remainders : ∀ j : Fin 44,
    strip ((columnDifference j).length - 44) (columnDifference j) = List.replicate 44 0 := by
  decide +kernel

theorem basis_inverse : ∀ i j : Fin 44,
    matrixProduct basisColumns inverseColumns i j = (if i = j then 1 else 0) := by
  decide +kernel

theorem inverse_basis : ∀ i j : Fin 44,
    matrixProduct inverseColumns basisColumns i j = (if i = j then 1 else 0) := by
  decide +kernel

