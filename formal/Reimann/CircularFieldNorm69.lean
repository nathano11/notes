import Reimann.CircularPolynomialField69
import Reimann.CircularFieldBasis69
import Reimann.CircularMultiplication69
import Reimann.CircularNormTransport69

/-! The norm on the generated cyclotomic field, defined on every field
element as the determinant of multiplication in the proved relative basis. -/

namespace Reimann.CircularFieldNorm69

open Lean.Grind CircularFieldBasis69 CircularRelationEval69 CircularFiniteSum69
  CircularRelativeBasis69 CircularPolynomialField69 CircularNormTransport69
  CircularRationalPeriod69

abbrev Coeff := CircularRational69.Element

theorem value_in_generated_field {R : Type} [Field R] [IsCharP R 0] (x : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (v : Fin 22 → Coeff) :
    Generated x (relativeValue x v) := by
  let q := CircularBasis69.applyMatrix CircularBasisData69.basisColumns (flatten v)
  have h := change_to_ordinary x (CircularPrimitive69.phi_vanishes_of_order69 x h69 h23 h3) v
  exact ⟨extendCoeffs q,44,extend_bounded q,(evalAt_extendCoeffs_right x q).trans h⟩

theorem coordinates_exist {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (hy : Generated x y) :
    ∃ v : Fin 22 → Coeff, relativeValue x v = y := by
  obtain ⟨p,hp⟩ := hy
  obtain ⟨v,hv,_⟩ := primitive_relative_coordinates x y h69 h23 h3 p hp
  exact ⟨v,hv⟩

noncomputable def coordinates {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (hy : Generated x y) :
    Fin 22 → Coeff :=
  Classical.choose (coordinates_exist x y h69 h23 h3 hy)

theorem coordinates_evaluate {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (hy : Generated x y) :
    relativeValue x (coordinates x y h69 h23 h3 hy) = y :=
  Classical.choose_spec (coordinates_exist x y h69 h23 h3 hy)

theorem coordinates_of_value {R : Type} [Field R] [IsCharP R 0] (x : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (v : Fin 22 → Coeff) :
    coordinates x (relativeValue x v) h69 h23 h3 (value_in_generated_field x h69 h23 h3 v) = v :=
  relative_value_injective x h69 h23 h3 _ _ (coordinates_evaluate x _ h69 h23 h3 _)

theorem multiply_power_mem {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (hy : Generated x y) (j : Fin 22) : Generated x (y * x^j.val) := by
  rw [CommSemiring.mul_comm y]
  simpa only [ofRat_one, Semiring.one_mul] using generated_shift x y j.val 1 hy

noncomputable def multiplicationColumn {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (hy : Generated x y)
    (j : Fin 22) : Fin 22 → Coeff :=
  coordinates x (y * x^j.val) h69 h23 h3 (multiply_power_mem x y hy j)

theorem multiplication_column_value {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (hy : Generated x y) (j : Fin 22) :
    relativeValue x (multiplicationColumn x y h69 h23 h3 hy j) = y * x^j.val :=
  coordinates_evaluate x _ h69 h23 h3 _

/-- The determinant of multiplication by y on the entire field generated by x,
with coefficients in the rational quadratic field of the chosen period. -/
noncomputable def relativeNorm {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (hy : Generated x y) : Coeff :=
  laplace 22 (List.ofFn (fun i : Fin 22 =>
    List.ofFn (fun j : Fin 22 => multiplicationColumn x y h69 h23 h3 hy j i)))

theorem one_sub_mem {R : Type} [Field R] [IsCharP R 0] (x : R) : Generated x (1-x) :=
  generated_sub x 1 x (generated_one x) (generated_root x)

theorem one_sub_columns {R : Type} [Field R] [IsCharP R 0] (x : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) (j : Fin 22) :
    multiplicationColumn x (1-x) h69 h23 h3 (one_sub_mem x) j =
      fun i => CircularMultiplication69.entry i j :=
  relative_value_injective x h69 h23 h3 _ _
    ((multiplication_column_value x _ h69 h23 h3 _ j).trans
      (CircularMultiplication69.column_value x h69 h23 h3 j).symm)

theorem norm_one_sub {R : Type} [Field R] [IsCharP R 0] (x : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) :
    relativeNorm x (1-x) h69 h23 h3 (one_sub_mem x) =
      11 + 3 * CircularRational69.theta := by
  unfold relativeNorm
  simp only [one_sub_columns x h69 h23 h3]
  rw [CircularMultiplication69.entries_as_embedded_rows]
  exact positive_determinant_at_root _ (by decide +kernel)

theorem epsilon_as_coefficient :
    (11 + 3 * CircularRational69.theta : Coeff) = ofIntegral CircularQuadratic69.epsilon := by
  decide +kernel

theorem positive_product_eq_coordinate_norm {R : Type} [Field R] [IsCharP R 0] (x : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) :
    CircularPolynomial69.signedProduct x 1 = evaluate (CircularFactor69.periodTheta x)
      (relativeNorm x (1-x) h69 h23 h3 (one_sub_mem x)) := by
  rw [norm_one_sub, epsilon_as_coefficient]
  exact (primitive_epsilon_image x h69 h23 h3).symm

end Reimann.CircularFieldNorm69
