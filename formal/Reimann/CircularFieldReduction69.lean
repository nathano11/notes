import Reimann.CircularIndependence69
import Reimann.CircularIntegralNormal69
import Reimann.CircularReduction69
import Reimann.CircularFactor69
import Reimann.CircularNonpower69

/-! Reduction at the labelled auxiliary prime on the integral subring
of a characteristic-zero field generated by a primitive conductor-69 root. -/
namespace Reimann.CircularFieldReduction69

open Lean.Grind CircularGauss69 CircularMonomial69 CircularHorner69
open CircularRelationEval69 CircularPolynomial69 CircularReduction69
attribute [local instance] Ring.intCast

def ratCoeffs (p : List Int) (i : Nat) : Rat := ((coeff p i : Int) : Rat)

theorem ratCoeffs_bounded (p : List Int) (m : Nat) (hm : p.length ≤ m) :
    Bounded (ratCoeffs p) m := by
  intro i hi
  simp [ratCoeffs, coeff, List.getElem?_eq_none (Nat.le_trans hm hi)]

theorem eval_integer_at_cutoff {R : Type} [Field R] (x : R) (p : List Int) (m : Nat)
    (hlen : p.length ≤ m) : evalAt x (ratCoeffs p) m = eval x p := by
  rw [eval_extend x _ p.length m (ratCoeffs_bounded p _ (Nat.le_refl _)) hlen]
  simpa only [evalAt, ratCoeffs, rational_integer_value] using horner_eq_sum x p

theorem eval_of_zero_coeff {R : Type} [CommRing R] (y : R) (p : List Int)
    (hc : ∀ i, coeff p i = 0) : eval y p = 0 := by
  induction p with
  | nil => rfl
  | cons c p ih =>
    have h0 : c = 0 := hc 0
    rw [eval, h0, Ring.intCast_zero, ih (fun i => hc (i+1)), Semiring.mul_zero]
    grind only

theorem coeff_zero_of_rat (p : List Int) (hc : ∀ i, ratCoeffs p i = 0) :
    ∀ i, coeff p i = 0 := by
  intro i
  have h := hc i
  change ((coeff p i : Int) : Rat) = ((0 : Int) : Rat) at h
  exact Rat.intCast_inj.mp h

/-- Values in the ambient field represented by integer polynomials in x. -/
def IntegralOrder {R : Type} [CommRing R] (x : R) := {y : R // ∃ p : List Int, eval x p = y}

def fromPoly {R : Type} [CommRing R] (x : R) (p : List Int) : IntegralOrder x :=
  ⟨eval x p, p, rfl⟩

noncomputable def representative {R : Type} [CommRing R] {x : R} (u : IntegralOrder x) :
    List Int := Classical.choose u.property

theorem eval_representative {R : Type} [CommRing R] {x : R} (u : IntegralOrder x) :
    eval x (representative u) = u.val := Classical.choose_spec u.property

structure Primitive69 {R : Type} [Field R] (x : R) : Prop where
  order69 : x^69 = 1
  not23 : x^23 ≠ 1
  not3 : x^3 ≠ 1

noncomputable def reduction {R : Type} [Field R] [IsCharP R 0] {x : R}
    (_hx : Primitive69 x) (u : IntegralOrder x) :
    Fin 114679 := reduce (polyClass (representative u))

def difference (p q : List Int) : List Int :=
  add p (q.map (fun b => (-1 : Int) * b))

theorem eval_difference {R : Type} [CommRing R] (y : R) (p q : List Int) :
    eval y (difference p q) = eval y p - eval y q := by
  rw [difference, eval_add, CircularPolynomial69.eval_scale, Ring.intCast_neg, Ring.intCast_one]
  grind only

def orderAdd {R : Type} [CommRing R] {x : R} (u v : IntegralOrder x) : IntegralOrder x :=
  ⟨u.val + v.val, by
    obtain ⟨p, hp⟩ := u.property
    obtain ⟨q, hq⟩ := v.property
    exact ⟨add p q, by rw [eval_add, hp, hq]⟩⟩

def orderNeg {R : Type} [CommRing R] {x : R} (u : IntegralOrder x) : IntegralOrder x :=
  ⟨-u.val, by
    obtain ⟨p, hp⟩ := u.property
    refine ⟨p.map (fun c => (-1 : Int) * c), ?_⟩
    rw [CircularPolynomial69.eval_scale, Ring.intCast_neg, Ring.intCast_one, hp]
    grind only⟩

def orderMul {R : Type} [CommRing R] {x : R} (u v : IntegralOrder x) : IntegralOrder x :=
  ⟨u.val * v.val, by
    obtain ⟨p, hp⟩ := u.property
    obtain ⟨q, hq⟩ := v.property
    exact ⟨mul p q, by rw [eval_mul, hp, hq]⟩⟩

def orderPow {R : Type} [CommRing R] {x : R} (u : IntegralOrder x) : Nat → IntegralOrder x
  | 0 => fromPoly x [1]
  | n+1 => orderMul (orderPow u n) u

theorem orderPow_value {R : Type} [CommRing R] {x : R} (u : IntegralOrder x) (n : Nat) :
    (orderPow u n).val = u.val^n := by
  induction n with
  | zero =>
    change eval x [1] = _
    simp [eval, Ring.intCast_one, Semiring.pow_zero, Semiring.mul_zero, Semiring.add_zero]
  | succ n ih => exact (congrArg (fun a => a*u.val) ih).trans (Semiring.pow_succ ..).symm

def period {R : Type} [CommRing R] (x : R) : IntegralOrder x :=
  fromPoly x CircularFactor69.periodPoly

def discriminantRoot {R : Type} [CommRing R] (x : R) : IntegralOrder x :=
  fromPoly x (difference (CircularFactor69.periodPoly.map (fun c => (2 : Int) * c)) [1])

theorem discriminantRoot_value {R : Type} [CommRing R] (x : R) :
    (discriminantRoot x).val = 2 * CircularFactor69.periodTheta x - 1 := by
  change eval x (difference _ _) = _
  rw [eval_difference, CircularPolynomial69.eval_scale]
  simp only [CircularFactor69.periodTheta, eval, Ring.intCast_one, Semiring.mul_zero, Semiring.add_zero]
  grind only

def signedUnit {R : Type} [CommRing R] (x : R) (s : Nat) : IntegralOrder x :=
  fromPoly x (factors (exponents s))

theorem signedUnit_value {R : Type} [CommRing R] (x : R) (s : Nat) :
    (signedUnit x s).val = signedProduct x s := eval_factors x _

theorem short_relation_zero {R : Type} [Field R] [IsCharP R 0] {x : R} (hx : Primitive69 x)
    (p : List Int) (hlen : p.length ≤ 44) (he : eval x p = 0) : ∀ i, coeff p i = 0 :=
  coeff_zero_of_rat p (CircularIndependence69.primitive_monomials_independent x
    hx.order69 hx.not23 hx.not3 (ratCoeffs p) (ratCoeffs_bounded p 44 hlen)
    ((eval_integer_at_cutoff x p 44 hlen).trans he))

theorem primitive_phi {R : Type} [Field R] {x : R} (hx : Primitive69 x) : eval x phi = 0 :=
  CircularPrimitive69.phi_vanishes_of_order69 x hx.order69 hx.not23 hx.not3

theorem period_value {R : Type} [CommRing R] (x : R) :
    (period x).val = CircularFactor69.periodTheta x := rfl

theorem auxiliary_period : CircularFactor69.periodTheta (21767 : Fin 114679) = 92746 := by
  decide +kernel

theorem auxiliary_discriminant :
    2 * CircularFactor69.periodTheta (21767 : Fin 114679) - 1 = 70812 := by
  rw [auxiliary_period]
  decide +kernel

theorem auxiliary_power_coordinates :
    (48891 : Fin 114679)^414 = 74194 ∧ (49063 : Fin 114679)^159 = 74194 ∧
    (65813 : Fin 114679)^414 = 5365 ∧ (49063 : Fin 114679)^118 = 5365 := by
  decide +kernel

theorem auxiliary_coordinate_difference :
    (159 + 277 - 118) % 277 = 41 ∧ (2 * 159) % 277 = 41 := by decide

theorem auxiliary_log_base_order :
    (49063 : Fin 114679)^277 = 1 ∧
      ∀ d : Fin 277, d.val ≠ 0 → (49063 : Fin 114679)^d.val ≠ 1 := by
  decide +kernel

theorem auxiliary_log_base_injective : ∀ a b : Fin 277,
    (49063 : Fin 114679)^a.val = (49063 : Fin 114679)^b.val → a = b := by
  intro a b hab
  have ordered (c d : Fin 277) (hle : c.val ≤ d.val)
      (he : (49063 : Fin 114679)^c.val = (49063 : Fin 114679)^d.val) : c = d := by
    have hprod := congrArg (fun y : Fin 114679 => y * 49063^(277-c.val)) he
    change (49063 : Fin 114679)^c.val * 49063^(277-c.val) =
      49063^d.val * 49063^(277-c.val) at hprod
    have hr : d.val + (277-c.val) = (d.val-c.val) + 277 := by omega
    have hl : c.val + (277-c.val) = 277 := by omega
    rw [← Semiring.pow_add, ← Semiring.pow_add, hl, hr, Semiring.pow_add,
      auxiliary_log_base_order.1, Semiring.mul_one] at hprod
    by_cases hcd : c.val = d.val
    · exact Fin.ext hcd
    · exact False.elim (auxiliary_log_base_order.2 ⟨d.val-c.val, by omega⟩ (by
        change d.val - c.val ≠ 0; omega) hprod.symm)
  by_cases h : a.val ≤ b.val
  · exact ordered a b h hab
  · exact (ordered b a (by omega) hab.symm).symm

theorem congruent_zero_of_vanishing {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (p : List Int) (hp : eval x p = 0) : Congruent p [] := by
  obtain ⟨q, hl, hc⟩ := CircularIntegralNormal69.integral_normal_form p
  have eqzero := (eval_agrees_at_root x (primitive_phi hx) hc).symm.trans hp
  have hz := short_relation_zero hx q hl eqzero
  exact congruent_trans hc (congruent_of_identity q [] (fun _ _ y => eval_of_zero_coeff y q hz))

theorem congruent_of_equal_values {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (p q : List Int) (h : eval x p = eval x q) : Congruent p q := by
  have hd : eval x (difference p q) = 0 := by rw [eval_difference, h]; grind only
  obtain ⟨w, hw⟩ := congruent_zero_of_vanishing hx (difference p q) hd
  refine ⟨w, ?_⟩
  intro K _ y
  have e := hw K y
  rw [eval_difference, eval] at e
  grind only

theorem atRoot_injective {R : Type} [Field R] [IsCharP R 0] {x : R} (hx : Primitive69 x)
    (u v : ResidueOrder) : atRoot x (primitive_phi hx) u = atRoot x (primitive_phi hx) v → u = v := by
  refine Quotient.inductionOn₂ u v ?_
  intro p q he
  exact Quotient.sound (s := polynomialSetoid) (congruent_of_equal_values hx p q he)

theorem reduction_of_evaluation {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (u : IntegralOrder x) (p : List Int) (hp : eval x p = u.val) :
    reduction hx u = reduce (polyClass p) := by
  apply congrArg reduce
  apply Quotient.sound (s := polynomialSetoid)
  exact congruent_of_equal_values hx _ _ ((eval_representative u).trans hp.symm)

theorem reduction_fromPoly {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (p : List Int) : reduction hx (fromPoly x p) = reduce (polyClass p) :=
  reduction_of_evaluation hx _ p rfl

theorem reduction_constant {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (c : Int) : reduction hx (fromPoly x [c]) = Int.cast c := by
  rw [reduction_fromPoly]
  exact atRoot_constant 21767 auxiliary_root c

theorem reduction_generator {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) : reduction hx (fromPoly x [0,1]) = 21767 :=
  (reduction_fromPoly hx _).trans reduce_generator

theorem reduction_add {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (u v : IntegralOrder x) :
    reduction hx (orderAdd u v) = reduction hx u + reduction hx v := by
  obtain ⟨p, hp⟩ := u.property
  obtain ⟨q, hq⟩ := v.property
  have hs : eval x (add p q) = (orderAdd u v).val := by rw [eval_add, hp, hq]; rfl
  rw [reduction_of_evaluation hx _ _ hs, reduction_of_evaluation hx _ _ hp,
    reduction_of_evaluation hx _ _ hq]
  exact reduce_add (polyClass p) (polyClass q)

theorem reduction_neg {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (u : IntegralOrder x) :
    reduction hx (orderNeg u) = -reduction hx u := by
  obtain ⟨p, hp⟩ := u.property
  have hs : eval x (p.map (fun c => (-1 : Int) * c)) = (orderNeg u).val := by
    rw [CircularPolynomial69.eval_scale, Ring.intCast_neg, Ring.intCast_one, hp]
    change -1 * u.val = -u.val
    grind only
  rw [reduction_of_evaluation hx _ _ hs, reduction_of_evaluation hx _ _ hp]
  change eval (21767 : Fin 114679) (p.map _) = -eval 21767 p
  rw [CircularPolynomial69.eval_scale, Ring.intCast_neg, Ring.intCast_one]
  grind only

theorem reduction_mul {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (u v : IntegralOrder x) :
    reduction hx (orderMul u v) = reduction hx u * reduction hx v := by
  obtain ⟨p, hp⟩ := u.property
  obtain ⟨q, hq⟩ := v.property
  have hs : eval x (mul p q) = (orderMul u v).val := by rw [eval_mul, hp, hq]; rfl
  rw [reduction_of_evaluation hx _ _ hs, reduction_of_evaluation hx _ _ hp,
    reduction_of_evaluation hx _ _ hq]
  exact reduce_mul (polyClass p) (polyClass q)

theorem reduction_pow {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (u : IntegralOrder x) (n : Nat) :
    reduction hx (orderPow u n) = (reduction hx u)^n := by
  induction n with
  | zero => rw [orderPow, reduction_constant, Ring.intCast_one, Semiring.pow_zero]
  | succ n ih => rw [orderPow, reduction_mul, ih, Semiring.pow_succ]

theorem reduction_period {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) : reduction hx (period x) = 92746 :=
  (reduction_fromPoly hx _).trans auxiliary_period

theorem reduction_discriminantRoot {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) : reduction hx (discriminantRoot x) = 70812 := by
  rw [discriminantRoot, reduction_fromPoly]
  change (discriminantRoot (21767 : Fin 114679)).val = _
  exact (discriminantRoot_value _).trans auxiliary_discriminant

theorem reduction_positive {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) : reduction hx (signedUnit x 1) = 48891 :=
  (reduction_fromPoly hx _).trans reduce_positive

theorem reduction_negative {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) : reduction hx (signedUnit x 276) = 65813 :=
  (reduction_fromPoly hx _).trans reduce_negative

theorem projected_positive {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) : reduction hx (orderPow (signedUnit x 1) 414) = 74194 := by
  rw [reduction_pow, reduction_positive]
  exact auxiliary_power_coordinates.1

theorem projected_negative {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) : reduction hx (orderPow (signedUnit x 276) 414) = 5365 := by
  rw [reduction_pow, reduction_negative]
  exact auxiliary_power_coordinates.2.2.1

theorem positive_log_coordinate {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (a : Fin 277) :
    (49063 : Fin 114679)^a.val = reduction hx (orderPow (signedUnit x 1) 414) ↔ a = 159 := by
  rw [projected_positive, ← auxiliary_power_coordinates.2.1]
  exact ⟨auxiliary_log_base_injective a 159, fun e => by rw [e]; rfl⟩

theorem negative_log_coordinate {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (a : Fin 277) :
    (49063 : Fin 114679)^a.val = reduction hx (orderPow (signedUnit x 276) 414) ↔ a = 118 := by
  rw [projected_negative, ← auxiliary_power_coordinates.2.2.2]
  exact ⟨auxiliary_log_base_injective a 118, fun e => by rw [e]; rfl⟩

theorem signed_units_nonpowers {R : Type} [Field R] [IsCharP R 0] {x : R}
    (hx : Primitive69 x) (u : IntegralOrder x) :
    u.val^277 ≠ signedProduct x 1 ∧ u.val^277 ≠ signedProduct x 276 := by
  have impossible := CircularNonpower69.signed_nonpowers (reduction hx u)
  have obs (s : Nat) (he : u.val^277 = signedProduct x s) :
      (reduction hx u)^277 = reduction hx (signedUnit x s) := by
    have hs : orderPow u 277 = signedUnit x s :=
      Subtype.ext ((orderPow_value u 277).trans (he.trans (signedUnit_value x s).symm))
    rw [← reduction_pow, hs]
  exact ⟨fun h => impossible.1 ((obs 1 h).trans (reduction_positive hx)),
    fun h => impossible.2 ((obs 276 h).trans (reduction_negative hx))⟩

end Reimann.CircularFieldReduction69
