import Reimann.CircularFieldNorm69
import Reimann.CircularRelativeGalois69

/-! Enumerate all automorphisms of the generated cyclotomic field fixing the
quadratic period field, and identify their product on the circular factor. -/
namespace Reimann.CircularNormIdentification69

open Lean.Grind CircularPolynomial69 CircularFieldNorm69 CircularSubstitution69
  CircularRelativeGalois69 CircularGalois69 CircularFieldReduction69

def labelOfExponent (a : {i : Nat // i ∈ exponents 1}) : PositiveLabel :=
  ⟨⟨a.val, List.mem_range.mp (List.mem_filter.mp a.property).1⟩,
    beq_iff_eq.mp (List.mem_filter.mp a.property).2⟩

def positiveLabels : List PositiveLabel :=
  (exponents 1).attach.map labelOfExponent

theorem labels_exponents : positiveLabels.map (fun a => a.val.val) = exponents 1 := by
  change (((exponents 1).attach.map labelOfExponent).map (fun a => a.val.val)) = _
  rw [List.map_map]
  exact List.attach_map_subtype_val _

theorem labels_complete (a : PositiveLabel) : a ∈ positiveLabels := by
  have hm : a.val.val ∈ exponents 1 :=
    List.mem_filter.mpr ⟨List.mem_range.mpr a.val.isLt, beq_iff_eq.mpr a.property⟩
  rw [← labels_exponents] at hm
  obtain ⟨b, hb, h⟩ := List.mem_map.mp hm
  have e : b = a := Subtype.ext (Fin.ext h)
  exact e ▸ hb

theorem positive_labels_nodup : positiveLabels.Nodup := by
  have h : (exponents 1).Nodup := by decide +kernel
  rw [← labels_exponents] at h
  exact List.Pairwise.of_map (fun a => a.val.val) (fun _ _ hn eqn => hn (eqn ▸ rfl)) h

theorem positive_labels_count : positiveLabels.length = 22 := by
  have h := congrArg List.length labels_exponents
  rw [List.length_map] at h
  exact h.trans signed_exponent_counts.1

theorem eval_one_sub_poly {R : Type} [CommRing R] (x : R) : eval x [1, -1] = 1-x := by
  simp only [eval, Ring.intCast_one, Ring.intCast_neg, Semiring.mul_zero, Semiring.add_zero]
  grind only

noncomputable def allRelativeAutos {R : Type} [Field R] [IsCharP R 0] (x : R)
    (hx : Primitive69 x) : List (RelativeAuto x hx) := positiveLabels.map (fromLabel x hx)

theorem autos_complete {R : Type} [Field R] [IsCharP R 0] (x : R)
    (hx : Primitive69 x) (e : RelativeAuto x hx) : e ∈ allRelativeAutos x hx :=
  List.mem_map.mpr ⟨toLabel e, labels_complete _, from_to x hx e⟩

theorem autos_nodup {R : Type} [Field R] [IsCharP R 0] (x : R) (hx : Primitive69 x) :
    (allRelativeAutos x hx).Nodup := by
  apply List.Pairwise.map (fromLabel x hx) _ positive_labels_nodup
  intro a b h eqn
  exact h ((to_from x hx a).symm.trans ((congrArg toLabel eqn).trans (to_from x hx b)))

theorem autos_count {R : Type} [Field R] [IsCharP R 0] (x : R) (hx : Primitive69 x) :
    (allRelativeAutos x hx).length = 22 := by
  rw [allRelativeAutos, List.length_map, positive_labels_count]

def circularFactor {R : Type} [Field R] [IsCharP R 0] (x : R) : Carrier x :=
  ⟨1-x, one_sub_mem x⟩

theorem conjugate_of_factor {R : Type} [Field R] [IsCharP R 0] {x : R}
    {hx : Primitive69 x} (e : RelativeAuto x hx) :
    (e.val.forward (circularFactor x)).val = 1 - generatorImage e.val :=
  (map_int_poly e.val (circularFactor x) [1,-1] (eval_one_sub_poly x)).trans
    (eval_one_sub_poly (generatorImage e.val))

theorem conjugate_by_label {R : Type} [Field R] [IsCharP R 0] (x : R)
    (hx : Primitive69 x) (a : PositiveLabel) :
    ((fromLabel x hx a).val.forward (circularFactor x)).val = 1 - x^a.val.val := by
  rw [conjugate_of_factor, from_generator]

noncomputable def orbitProduct {R : Type} [Field R] [IsCharP R 0] (x : R)
    (hx : Primitive69 x) : R :=
  (allRelativeAutos x hx).foldr (fun e acc => (e.val.forward (circularFactor x)).val * acc) 1

theorem orbit_product_eq_signed {R : Type} [Field R] [IsCharP R 0] (x : R)
    (hx : Primitive69 x) : orbitProduct x hx = signedProduct x 1 := by
  unfold orbitProduct allRelativeAutos signedProduct
  rw [← labels_exponents]
  simp only [List.foldr_map, conjugate_by_label]

theorem orbit_product_eq_norm {R : Type} [Field R] [IsCharP R 0] (x : R)
    (hx : Primitive69 x) : orbitProduct x hx =
      CircularRationalPeriod69.evaluate (CircularFactor69.periodTheta x)
        (relativeNorm x (1-x) hx.order69 hx.not23 hx.not3 (one_sub_mem x)) :=
  (orbit_product_eq_signed x hx).trans
    (positive_product_eq_coordinate_norm x hx.order69 hx.not23 hx.not3)

end Reimann.CircularNormIdentification69

namespace Reimann.CircularNorm69

open Lean.Grind CircularFieldNorm69 CircularNormIdentification69 CircularFieldReduction69

/-- The positive circular product is the image of the relative norm on the
field generated by x. The positive labels enumerate its quadratic-fixing
automorphisms exactly once. The three power tests give exact order 69. -/
theorem positive_product_eq_relative_norm {R : Type} [Field R] [IsCharP R 0] (x : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) :
    CircularPolynomial69.signedProduct x 1 = CircularRationalPeriod69.evaluate
      (CircularFactor69.periodTheta x) (relativeNorm x (1-x) h69 h23 h3 (one_sub_mem x)) := by
  let hx : Primitive69 x := ⟨h69, h23, h3⟩
  exact (orbit_product_eq_signed x hx).symm.trans (orbit_product_eq_norm x hx)

end Reimann.CircularNorm69
