import Reimann.CircularIndependence69

/-! Inverses and minimality of the field generated by a primitive 69th root. -/
namespace Reimann.CircularPolynomialField69

open Lean.Grind Lean.Grind.Field.NormNum CircularGauss69 CircularMonomial69
  CircularLeastRelation69 CircularRelationEval69 CircularNormalForm69

def Generated {R : Type} [Field R] (x y : R) : Prop :=
  ∃ p, Represents x p y

theorem represents_constant {R : Type} [Field R] (x : R) (a : Rat) :
    Represents x (atom 0 a) (ofRat a) := by
  refine ⟨1, fun i hi => ?_, ?_⟩
  · simp [atom, show i ≠ 0 by omega]
  · change 0 + ofRat (atom 0 a 0) * x^0 = _
    change 0 + ofRat a * x^0 = ofRat a
    rw [Semiring.pow_zero, Semiring.mul_one]
    grind only

theorem represents_shift {R : Type} [Field R] [IsCharP R 0] (x u : R)
    (p : Nat → Rat) (s : Nat) (a : Rat) (h : Represents x p u) :
    Represents x (shift s a p) ((ofRat a * x^s) * u) := by
  obtain ⟨m,hb,he⟩ := h
  exact ⟨s+m,bounded_shift s a p m hb,by rw [eval_shift, he]⟩

theorem represents_sub {R : Type} [Field R] [IsCharP R 0] (x u v : R)
    (p q : Nat → Rat) (hp : Represents x p u) (hq : Represents x q v) :
    Represents x (fun k => p k - q k) (u-v) := by
  obtain ⟨m,bm,em⟩ := hp
  obtain ⟨n,bn,en⟩ := hq
  refine ⟨max m n, ?_, ?_⟩
  · intro k hk
    change p k - q k = 0
    rw [bm k (by omega), bn k (by omega), Rat.sub_self]
  · rw [eval_sub, eval_extend x p m _ bm (Nat.le_max_left ..),
      eval_extend x q n _ bn (Nat.le_max_right ..), em, en]

theorem generated_rational {R : Type} [Field R] (x : R) (a : Rat) :
    Generated x (ofRat a) :=
  ⟨_,represents_constant x a⟩

theorem generated_shift {R : Type} [Field R] [IsCharP R 0] (x u : R)
    (s : Nat) (a : Rat) (h : Generated x u) : Generated x ((ofRat a * x^s) * u) := by
  obtain ⟨p,hp⟩ := h
  exact ⟨_,represents_shift x u p s a hp⟩

theorem generated_sub {R : Type} [Field R] [IsCharP R 0] (x u v : R)
    (hu : Generated x u) (hv : Generated x v) : Generated x (u-v) := by
  obtain ⟨p,hp⟩ := hu
  obtain ⟨q,hq⟩ := hv
  exact ⟨_,represents_sub x u v p q hp hq⟩

theorem generated_zero {R : Type} [Field R] (x : R) : Generated x 0 := by
  simpa only [ofRat_zero] using generated_rational x 0

theorem generated_one {R : Type} [Field R] (x : R) : Generated x 1 := by
  simpa only [ofRat_one] using generated_rational x 1

theorem generated_root {R : Type} [Field R] [IsCharP R 0] (x : R) : Generated x x := by
  simpa only [ofRat_one, Semiring.pow_one, Semiring.one_mul, Semiring.mul_one]
    using generated_shift x 1 1 1 (generated_one x)

theorem generated_add {R : Type} [Field R] [IsCharP R 0] (x u v : R)
    (hu : Generated x u) (hv : Generated x v) : Generated x (u+v) := by
  have h := generated_sub x u (0-v) hu (generated_sub x 0 v (generated_zero x) hv)
  rwa [show u-(0-v) = u+v by grind only] at h

theorem eval_mul_generated {R : Type} [Field R] [IsCharP R 0] (x u : R)
    (p : Nat → Rat) (m : Nat) (hu : Generated x u) : Generated x (evalAt x p m * u) := by
  induction m with
  | zero => change Generated x (0 * u); rw [Semiring.zero_mul]; exact generated_zero x
  | succ m =>
    rw [eval_succ, Semiring.right_distrib]
    exact generated_add x _ _ ‹Generated x (evalAt x p m * u)› (generated_shift x u m (p m) hu)

theorem generated_mul {R : Type} [Field R] [IsCharP R 0] (x u v : R)
    (hu : Generated x u) (hv : Generated x v) : Generated x (u*v) := by
  obtain ⟨p,m,_,rfl⟩ := hu
  exact eval_mul_generated x v p m hv

def Multiple {R : Type} [Field R] (x y : R) (p : Nat → Rat) : Prop :=
  ∃ z, Generated x z ∧ Represents x p (y*z)

theorem multiple_of_vanishes {R : Type} [Field R] (x y : R) (p : Nat → Rat)
    (h : Vanishes x p) : Multiple x y p := by
  exact ⟨0, generated_zero x, by rw [Semiring.mul_zero]; exact h⟩

theorem multiple_of_represents {R : Type} [Field R] (x y : R) (p : Nat → Rat)
    (h : Represents x p y) : Multiple x y p := by
  exact ⟨1, generated_one x, by rw [Semiring.mul_one]; exact h⟩

theorem multiple_shift {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (p : Nat → Rat) (s : Nat) (a : Rat) (h : Multiple x y p) :
    Multiple x y (shift s a p) := by
  obtain ⟨z,hz,ep⟩ := h
  refine ⟨(ofRat a * x^s)*z, generated_shift x z s a hz, ?_⟩
  have he := represents_shift x (y*z) p s a ep
  rwa [show (ofRat a * x^s)*(y*z) = y*((ofRat a * x^s)*z) by grind only] at he

theorem multiple_sub {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (p q : Nat → Rat) (hp : Multiple x y p) (hq : Multiple x y q) :
    Multiple x y (fun i => p i - q i) := by
  obtain ⟨v,bv,ep⟩ := hp
  obtain ⟨w,bw,eq⟩ := hq
  refine ⟨v-w,generated_sub x v w bv bw,?_⟩
  have he := represents_sub x _ _ p q ep eq
  rwa [show y*v-y*w = y*(v-w) by grind only] at he

theorem normalize_multiple {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (p : Nat → Rat) (m : Nat) (hp : Bounded p m) (hm : Multiple x y p) (hn : ∃ k, p k ≠ 0) :
    ∃ d < m, MonicRelation (Multiple x y) d := by
  obtain ⟨d,hd,nonzero,bound⟩ := last_nonzero p m hp hn
  let a := (p d)⁻¹
  refine ⟨d,hd,shift 0 a p,?_,?_,multiple_shift x y p 0 a hm⟩
  · simpa only [Nat.zero_add] using bounded_shift 0 a p (d+1) bound
  · simpa only [shift, Nat.zero_le, ite_true, Nat.sub_zero, a] using Rat.inv_mul_cancel _ nonzero

theorem constant_multiple_inverse {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (hy : y ≠ 0) (hc : MonicRelation (Multiple x y) 0) : Generated x y⁻¹ := by
  obtain ⟨D,bD,top,z,hz,repr⟩ := hc
  have he := value_at_bound x D _ repr 1 bD
  change 0 + ofRat (D 0) * x^0 = y*z at he
  rw [top, ofRat_one, Semiring.pow_zero, Semiring.mul_one] at he
  have prod : y*z = 1 := by grind only
  have inv := congrArg (fun t : R => y⁻¹*t) prod
  rw [← Semiring.mul_assoc, Field.inv_mul_cancel hy, Semiring.one_mul, Semiring.mul_one] at inv
  exact inv ▸ hz

theorem generated_short_multiple {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (P : Nat → Rat) (N : Nat) (bP : Bounded P (N+1)) (mP : P N = 1) (vP : Vanishes x P)
    (hy : y ≠ 0) (gen : Generated x y) : ∃ i < N, MonicRelation (Multiple x y) i := by
  obtain ⟨p,m,bp,ep⟩ := gen
  obtain ⟨r,br,er⟩ := normal_form_at_root x P N bP mP vP p m bp
  have rv : Represents x r y := ⟨N,br,er.trans ep⟩
  have nz : ∃ k, r k ≠ 0 := by
    apply Classical.byContradiction
    intro none
    have zero (k : Nat) : r k = 0 := Classical.byContradiction (fun h => none ⟨k,h⟩)
    exact hy ((er.trans ep).symm.trans (eval_zero_below x r N (fun k _ => zero k)))
  exact normalize_multiple x y r N br (multiple_of_represents x y r rv) nz

theorem inverse_at_irreducible {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (P : Nat → Rat) (N : Nat) (bP : Bounded P (N+1)) (mP : P N = 1) (vP : Vanishes x P)
    (irreducible : ∀ d e, 0 < d → 0 < e → d+e = N → ∀ q D, Bounded q (e+1) →
      Bounded D (d+1) → q e = 1 → D d = 1 → (∀ k, convolution q D k = P k) → False)
    (hy : y ≠ 0) (gen : Generated x y) : Generated x y⁻¹ := by
  apply Classical.byContradiction
  intro noinv
  have constant : ¬ MonicRelation (Multiple x y) 0 :=
    fun h => noinv (constant_multiple_inverse x y hy h)
  obtain ⟨i,hi,hshort⟩ := generated_short_multiple x y P N bP mP vP hy gen
  exact no_shorter_than_irreducible P N bP mP (Multiple x y) (multiple_of_vanishes x y P vP)
    constant (fun f D s a hf hD => multiple_sub x y f _ hf (multiple_shift x y D s a hD))
    (normalize_multiple x y) irreducible i hi hshort

theorem generated_inv {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1)
    (hy : y ≠ 0) (gen : Generated x y) : Generated x y⁻¹ :=
  inverse_at_irreducible x y CircularIndependence69.phiQ 44 CircularIndependence69.phiQ_bounded
    CircularIndependence69.phiQ_monic (CircularIndependence69.primitive_vanishes x h69 h23 h3)
    CircularIrreducible69.no_rational_split hy gen

/-- Closure data for a subfield of the ambient field containing the rationals and x. -/
structure SubfieldContaining {R : Type} [Field R] (x : R) (S : R → Prop) : Prop where
  rational : ∀ q : Rat, S (ofRat q)
  root : S x
  add : ∀ u v, S u → S v → S (u+v)
  sub : ∀ u v, S u → S v → S (u-v)
  mul : ∀ u v, S u → S v → S (u*v)
  inv : ∀ u, u ≠ 0 → S u → S u⁻¹

theorem generated_is_subfield {R : Type} [Field R] [IsCharP R 0] (x : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) :
    SubfieldContaining x (Generated x) :=
  ⟨generated_rational x, generated_root x, generated_add x, generated_sub x, generated_mul x,
    fun y => generated_inv x y h69 h23 h3⟩

theorem subfield_contains_powers {R : Type} [Field R] (x : R) (S : R → Prop)
    (hS : SubfieldContaining x S) (m : Nat) : S (x^m) := by
  induction m with
  | zero => simpa only [Semiring.pow_zero, ofRat_one] using hS.rational 1
  | succ m ih => rw [Semiring.pow_succ]; exact hS.mul _ _ ih hS.root

theorem subfield_contains_eval {R : Type} [Field R] (x : R) (S : R → Prop)
    (hS : SubfieldContaining x S) (p : Nat → Rat) (m : Nat) : S (evalAt x p m) := by
  induction m with
  | zero =>
    change S 0
    simpa only [ofRat_zero] using hS.rational 0
  | succ m ih =>
    rw [eval_succ]
    exact hS.add _ _ ih (hS.mul _ _ (hS.rational _) (subfield_contains_powers x S hS m))

theorem generated_least {R : Type} [Field R] (x : R) (S : R → Prop)
    (hS : SubfieldContaining x S) (y : R) (hy : Generated x y) : S y := by
  obtain ⟨p,m,_,rfl⟩ := hy
  exact subfield_contains_eval x S hS p m

theorem in_generated_subfield_iff {R : Type} [Field R] [IsCharP R 0] (x y : R)
    (h69 : x^69 = 1) (h23 : x^23 ≠ 1) (h3 : x^3 ≠ 1) :
    Generated x y ↔ ∀ S, SubfieldContaining x S → S y :=
  ⟨fun hy S hS => generated_least x S hS y hy,
    fun h => h (Generated x) (generated_is_subfield x h69 h23 h3)⟩

end Reimann.CircularPolynomialField69
