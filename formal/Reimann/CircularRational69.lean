import Reimann.TameRationalField277

/-! Rational coordinates in the quadratic field generated by θ² = θ + 17. -/

namespace Reimann.CircularRational69

open Lean.Grind

theorem rat_square_ne_69 (x : Rat) : x^2 ≠ 69 := by
  intro h
  apply TameRationalField277.no_rat_square_ratio (x * (1/3))
  have hthird : (3 : Rat) * (1/3) = 1 := by decide +kernel
  grind only

theorem theta_not_rational (t : Rat) : t^2 ≠ t + 17 := by
  intro h
  apply rat_square_ne_69 (2*t-1)
  grind only

structure Element where
  a : Rat
  b : Rat
  deriving DecidableEq

theorem ext_coordinates {x y : Element} (ha : x.a = y.a) (hb : x.b = y.b) :
    x = y := by
  cases x; cases y; congr

def scalar (q : Rat) : Element := ⟨q, 0⟩

def theta : Element := ⟨0, 1⟩

def plus (x y : Element) : Element := ⟨x.a + y.a, x.b + y.b⟩

def negative (x : Element) : Element := ⟨-x.a, -x.b⟩

def times (x y : Element) : Element :=
  ⟨x.a*y.a + 17*x.b*y.b, x.a*y.b + x.b*y.a + x.b*y.b⟩

def conjugate (x : Element) : Element := ⟨x.a+x.b, -x.b⟩

def norm (x : Element) : Rat := x.a*x.a + x.a*x.b - 17*x.b*x.b

theorem norm_discriminant (x : Element) :
    (2*x.a+x.b)^2 - 69*x.b^2 = 4*norm x := by
  unfold norm
  grind only

theorem norm_ne_zero (x : Element) (hx : x ≠ scalar 0) : norm x ≠ 0 := by
  intro hz
  by_cases hb : x.b = 0
  · apply hx
    apply ext_coordinates _ hb
    have ha : x.a*x.a = 0 := by unfold norm at hz; grind only
    exact (Rat.mul_eq_zero.mp ha).elim id id
  · have hd := norm_discriminant x
    have hi := Rat.mul_inv_cancel x.b hb
    have hm := congrArg (fun v : Rat => v * x.b⁻¹^2) hd
    apply rat_square_ne_69 ((2*x.a+x.b)*x.b⁻¹)
    grind only

def inverse (x : Element) : Element :=
  ⟨(x.a + x.b) * (norm x)⁻¹, -x.b * (norm x)⁻¹⟩

theorem times_conjugate (x : Element) : times x (conjugate x) = scalar (norm x) := by
  apply ext_coordinates <;> simp only [times, conjugate, scalar, norm] <;> grind only

theorem times_inverse (x : Element) (hx : x ≠ scalar 0) :
    times x (inverse x) = scalar 1 := by
  have hi := Rat.mul_inv_cancel (norm x) (norm_ne_zero x hx)
  unfold norm at hi
  apply ext_coordinates <;> simp only [times, inverse, scalar, norm] <;> grind only

theorem inverse_zero : inverse (scalar 0) = scalar 0 := by decide +kernel

theorem inverse_one : inverse (scalar 1) = scalar 1 := by decide +kernel

theorem theta_quadratic : times theta theta = plus theta (scalar 17) := by decide +kernel

theorem times_assoc (x y z : Element) : times (times x y) z = times x (times y z) := by
  apply ext_coordinates <;> simp only [times] <;> grind only

theorem times_comm (x y : Element) : times x y = times y x := by
  apply ext_coordinates <;> simp only [times] <;> grind only

theorem times_one (x : Element) : times x (scalar 1) = x := by
  apply ext_coordinates <;> simp only [times, scalar] <;> grind only

theorem times_zero (x : Element) : times x (scalar 0) = scalar 0 := by
  apply ext_coordinates <;> simp only [times, scalar] <;> grind only

theorem inverse_nonzero (x : Element) (hx : x ≠ scalar 0) : inverse x ≠ scalar 0 := by
  intro hz
  have h := times_inverse x hx
  rw [hz, times_zero] at h
  exact (by decide +kernel : scalar 0 ≠ scalar 1) h

theorem inverse_inverse (x : Element) : inverse (inverse x) = x := by
  by_cases hx : x = scalar 0
  · rw [hx, inverse_zero, inverse_zero]
  · calc
      inverse (inverse x) = times (inverse (inverse x)) (scalar 1) := (times_one _).symm
      _ = times (inverse (inverse x)) (times (inverse x) x) := by rw [times_comm (inverse x) x, times_inverse x hx]
      _ = times (times (inverse (inverse x)) (inverse x)) x := (times_assoc ..).symm
      _ = x := by rw [times_comm (inverse (inverse x)), times_inverse _ (inverse_nonzero x hx), times_comm, times_one]

theorem plus_zero (x : Element) : plus x (scalar 0) = x := by
  apply ext_coordinates <;> simp only [plus, scalar] <;> grind only

theorem plus_comm (x y : Element) : plus x y = plus y x := by
  apply ext_coordinates <;> simp only [plus] <;> grind only

theorem plus_assoc (x y z : Element) : plus (plus x y) z = plus x (plus y z) := by
  apply ext_coordinates <;> simp only [plus] <;> grind only

theorem times_distrib (x y z : Element) :
    times x (plus y z) = plus (times x y) (times x z) := by
  apply ext_coordinates <;> simp only [times, plus] <;> grind only

theorem negative_plus (x : Element) : plus (negative x) x = scalar 0 := by
  apply ext_coordinates <;> simp only [plus, negative, scalar] <;> grind only

def npow (x : Element) : Nat → Element
  | 0 => scalar 1
  | n+1 => times (npow x n) x

def zpow (x : Element) : Int → Element
  | .ofNat n => npow x n
  | .negSucc n => inverse (npow x (n+1))

theorem zpow_neg (x : Element) (n : Int) : zpow x (-n) = inverse (zpow x n) := by
  cases n with
  | ofNat n => cases n with
    | zero => exact inverse_one.symm
    | succ n => rfl
  | negSucc n => exact (inverse_inverse _).symm

theorem scalar_nat_succ (n : Nat) : scalar (↑(n+1) : Rat) = plus (scalar n) (scalar 1) := by
  apply ext_coordinates <;> simp only [plus, scalar] <;> grind only

theorem scalar_int_neg (n : Int) : scalar (↑(-n) : Rat) = negative (scalar n) := by
  apply ext_coordinates <;> simp only [negative, scalar, Rat.intCast_neg] <;> grind only

theorem times_negative (x y : Element) : times (negative x) y = negative (times x y) := by
  apply ext_coordinates <;> simp only [times, negative] <;> grind only

@[instance_reducible]
def quadraticRing : CommRing Element where
  add := plus
  mul := times
  neg := negative
  sub x y := plus x (negative y)
  natCast := ⟨fun n => scalar n⟩
  intCast := ⟨fun n => scalar n⟩
  ofNat n := ⟨scalar n⟩
  nsmul := ⟨fun n x => times (scalar n) x⟩
  zsmul := ⟨fun n x => times (scalar n) x⟩
  npow := ⟨npow⟩
  add_zero := plus_zero
  add_comm := plus_comm
  add_assoc := plus_assoc
  mul_assoc := times_assoc
  mul_one := times_one
  one_mul := fun x => (times_comm ..).trans (times_one x)
  mul_comm := times_comm
  zero_mul := fun x => (times_comm ..).trans (times_zero x)
  mul_zero := times_zero
  left_distrib := times_distrib
  right_distrib := fun a b c => by
    change times (plus a b) c = plus (times a c) (times b c)
    rw [times_comm (plus a b), times_distrib, times_comm c a, times_comm c b]
  pow_zero := fun _ => rfl
  pow_succ := fun _ _ => rfl
  ofNat_succ := scalar_nat_succ
  neg_add_cancel := negative_plus
  sub_eq_add_neg := fun _ _ => rfl
  intCast_neg := scalar_int_neg
  neg_zsmul := fun i a => (congrArg (fun s => times s a) (scalar_int_neg i)).trans (times_negative ..)

@[instance_reducible]
def quadraticField : Field Element where
  toCommRing := quadraticRing
  inv := inverse
  div x y := times x (inverse y)
  zpow := ⟨zpow⟩
  div_eq_mul_inv := fun _ _ => rfl
  zero_ne_one := by decide +kernel
  inv_zero := inverse_zero
  mul_inv_cancel := fun {a} => times_inverse a
  zpow_zero := fun _ => rfl
  zpow_succ := fun _ _ => rfl
  zpow_neg := zpow_neg

attribute [instance] quadraticField

theorem char_zero : IsCharP Element 0 where
  ofNat_ext_iff := by
    intro x y
    change scalar (x : Rat) = scalar (y : Rat) ↔ x % 0 = y % 0
    constructor
    · intro h
      have hh := congrArg Element.a h
      change (x : Rat) = (y : Rat) at hh
      simpa only [Nat.mod_zero] using Rat.natCast_inj.mp hh
    · intro h
      have : x = y := by omega
      rw [this]

attribute [instance] char_zero

theorem scalar_injective {p q : Rat} (h : scalar p = scalar q) : p = q :=
  congrArg Element.a h

theorem basis_expansion (x : Element) : x = scalar x.a + scalar x.b * theta := by
  change x = plus _ (times _ _)
  apply ext_coordinates <;> simp only [plus, times, theta, scalar] <;> grind only

def radical : Element := 2*theta-1

theorem radical_square : radical^2 = 69 := by decide +kernel

theorem theta_of_radical : (1 + radical) / 2 = theta := by decide +kernel

theorem canonical_scalar (q : Rat) : Field.NormNum.ofRat q = scalar q := by
  change times (scalar (q.num : Rat)) (inverse (scalar (q.den : Rat))) = scalar q
  have hd : (q.den : Rat) ≠ 0 := fun h => q.den_nz (Rat.natCast_inj.mp h)
  have hr := TameRationalField277.rational_numerator q
  rw [Rat.intCast_natCast] at hr
  have hdd : (q.den : Rat) * (q.den : Rat) ≠ 0 := fun h => (Rat.mul_eq_zero.mp h).elim hd hd
  have hi := Rat.mul_inv_cancel _ hdd
  apply ext_coordinates <;> simp only [times, inverse, scalar, norm] <;> grind only

end Reimann.CircularRational69
