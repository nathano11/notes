import Reimann.DyadicLocalRestriction69
import Reimann.DyadicPrimeExchange69
import Reimann.DyadicGenusField69

/-! Automorphisms of the field generated by the bottom biquadratic field and
the dyadic roots of unity commute on every field element. -/
namespace Reimann.DyadicAbelianTower69

open Lean.Grind Reimann.DyadicLocalRestriction69 Reimann.DyadicPrimeExchange69
open Reimann.DyadicGenusField69 Reimann.DyadicBottomValue69 Reimann.DyadicEmbeddedBase69
open Reimann.TameRationalField277 Reimann.DyadicCyclotomicSpan69

variable {F : Type} [Field F]

theorem map_neg (g : Automorphism F) (x : F) : g.app (-x)= -(g.app x) := by
  have h := g.add (-x) x
  rw [show -x+x=0 by grind,g.zero] at h
  grind

theorem map_inverse (g : Automorphism F) (x : F) : g.app (x⁻¹)=(g.app x)⁻¹ := by
  by_cases hx : x=0
  · rw [hx,Field.inv_zero,g.zero,Field.inv_zero]
  · have h := congrArg g.app (Field.inv_mul_cancel hx)
    rw [g.mul,g.one] at h
    exact Field.eq_inv_of_mul_eq_one h

theorem map_power (g : Automorphism F) (x : F) (n : Nat) : g.app (x^n)=(g.app x)^n := by
  induction n with
  | zero => simp only [Semiring.pow_zero,g.one]
  | succ n ih => rw [Semiring.pow_succ,g.mul,ih,Semiring.pow_succ]

/-- The agreement locus of the two composites is a subfield. -/
theorem composite_equalizer (g h : Automorphism F) :
    Subfield (fun x => g.app (h.app x)=h.app (g.app x)) where
  zero := by simp only [g.zero,h.zero]
  one := by simp only [g.one,h.one]
  add := by intro x y hx hy; simp only [g.add,h.add,hx,hy]
  neg := by intro x hx; simp only [map_neg,hx]
  mul := by intro x y hx hy; simp only [g.mul,h.mul,hx,hy]
  inv := by intro x hx; simp only [map_inverse,hx]

theorem map_sign (g : Automorphism F) (s : Bool) (x : F) :
    g.app (if s then -x else x) = (if s then -(g.app x) else g.app x) := by
  cases s
  · rfl
  · exact map_neg g x

theorem commute_on_radical (f : Embedding F) (g h : Automorphism F)
    (x : Biquad) (q : Rat) (hx : bm x x=scalar q) :
    g.app (h.app (f.app x))=h.app (g.app (f.app x)) := by
  obtain ⟨i,hi⟩ := radical_image_sign f g.app g.mul (fixed_rationals f g.app g.zero g.one g.add g.mul) x q hx
  obtain ⟨j,hj⟩ := radical_image_sign f h.app h.mul (fixed_rationals f h.app h.zero h.one h.add h.mul) x q hx
  calc
    _ = (if j then -(if i then -(f.app x) else f.app x) else (if i then -(f.app x) else f.app x)) := by
      rw [hj,map_sign,hi]
    _ = _ := by rw [hi,map_sign,hj]; cases i <;> cases j <;> rfl

theorem commute_on_bottom (f : Embedding F) (g h : Automorphism F) {x : F}
    (hx : baseImage f x) : g.app (h.app x)=h.app (g.app x) :=
  ((bottom_image_iff (composite_equalizer g h) f).mpr
    ⟨commute_on_radical f g h gen3 (-3) generator_squares.1,
     commute_on_radical f g h gen23 (-23) generator_squares.2⟩) x hx

theorem image_is_power (g : Automorphism F) (n : Nat) (z : F) (hz : z^(2^n : Nat)= -1) :
    ∃ a : Nat, g.app z=z^a := by
  have e : z^(2^(n+1) : Nat)=1 := by
    rw [← successor_power_square,CommSemiring.mul_pow,hz]
    grind
  apply powers_exhaust_roots n z (g.app z) hz
  rw [← map_power,e,g.one]

theorem iterated_power (z : F) (a b : Nat) : (z^a)^b=z^(a*b) := by
  induction b with
  | zero => simp [Semiring.pow_zero]
  | succ b ih => rw [Semiring.pow_succ,ih,Nat.mul_succ,Semiring.pow_add]

theorem commute_on_root (g h : Automorphism F) (n : Nat) (z : F) (hz : z^(2^n : Nat)= -1) :
    g.app (h.app z)=h.app (g.app z) := by
  obtain ⟨a,ha⟩ := image_is_power g n z hz
  obtain ⟨b,hb⟩ := image_is_power h n z hz
  calc
    _ = (z^a)^b := by rw [hb,map_power,ha]
    _ = (z^b)^a := by rw [iterated_power,iterated_power,Nat.mul_comm a b]
    _ = _ := by rw [ha,map_power,hb]

/-- Every pair of actual field automorphisms commutes on the full compositum
E₀(μ₂∞), with E₀ = ℚ(√−3,√−23) embedded in the ambient field. -/
theorem automorphisms_commute (f : Embedding F) (C : RootTower F)
    (generated : GeneratesField (baseImage f) C) (g h : Automorphism F) (x : F) :
    g.app (h.app x)=h.app (g.app x) :=
  generated _ (composite_equalizer g h) (fun _ hx => commute_on_bottom f g h hx)
    (fun n => commute_on_root g h n (C.root n) (C.half_order n)) x

end Reimann.DyadicAbelianTower69
