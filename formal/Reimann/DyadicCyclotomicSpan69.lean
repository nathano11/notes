import Std

/-! Bounded polynomial coordinates for the field generated by a dyadic cyclotomic root. -/

namespace Reimann.DyadicCyclotomicSpan69

open Lean.Grind

variable {F : Type u} [Field F]

structure Subfield (B : F → Prop) : Prop where
  zero : B 0
  one : B 1
  add : ∀ {x y}, B x → B y → B (x+y)
  neg : ∀ {x}, B x → B (-x)
  mul : ∀ {x y}, B x → B y → B (x*y)
  inv : ∀ {x}, B x → B x⁻¹

/-- Expressions obtained by field operations; no polynomial representation
is assumed. -/
inductive Generated (B : F → Prop) (z : F) : F → Prop where
  | base {x} : B x → Generated B z x
  | gen : Generated B z z
  | plus {x y} : Generated B z x → Generated B z y → Generated B z (x+y)
  | negative {x} : Generated B z x → Generated B z (-x)
  | times {x y} : Generated B z x → Generated B z y → Generated B z (x*y)
  | inverse {x} : Generated B z x → Generated B z x⁻¹

def horner (x : F) : List F → F
  | [] => 0
  | c::cs => c+x*horner x cs

/-- The finite coefficient vector can omit high zero coefficients. -/
def Bounded (B : F → Prop) (π : F) (d : Nat) (x : F) : Prop :=
  ∃ p : List F, p.length ≤ d ∧ (∀ c ∈ p, B c) ∧ horner π p=x

def addPoly : List F → List F → List F
  | [], q => q
  | p, [] => p
  | a::p,b::q => (a+b)::addPoly p q

theorem addPoly_spec {B : F → Prop} (b : Subfield B) (π : F) (p q : List F)
    (hp : ∀ c ∈ p, B c) (hq : ∀ c ∈ q, B c) :
    (addPoly p q).length ≤ max p.length q.length ∧ (∀ c ∈ addPoly p q, B c) ∧
    horner π (addPoly p q) = horner π p + horner π q := by
  induction p generalizing q with
  | nil => exact ⟨by simp [addPoly], hq, by simp only [addPoly,horner]; grind⟩
  | cons a p ih =>
    cases q with
    | nil => simpa [addPoly,horner,Semiring.add_zero] using hp
    | cons c q =>
      obtain ⟨len,coef,ev⟩ := ih q (fun t ht => hp t (List.mem_cons_of_mem _ ht))
        (fun t ht => hq t (List.mem_cons_of_mem _ ht))
      constructor
      · simp only [addPoly,List.length_cons]; omega
      constructor
      · intro t ht
        rcases List.mem_cons.mp ht with h | h
        · exact h ▸ b.add (hp _ (by simp)) (hq _ (by simp))
        · exact coef _ h
      · simp only [addPoly,horner,ev]; grind

theorem bounded_add {B : F → Prop} (b : Subfield B) {π x y : F} {d : Nat}
    (hx : Bounded B π d x) (hy : Bounded B π d y) : Bounded B π d (x+y) := by
  obtain ⟨p,lp,hp,ex⟩ := hx
  obtain ⟨q,lq,hq,ey⟩ := hy
  obtain ⟨len,coef,ev⟩ := addPoly_spec b π p q hp hq
  exact ⟨_,by omega,coef,by rw [ev,ex,ey]⟩

theorem horner_scale (π c : F) (p : List F) :
    horner π (p.map (fun a => c*a)) = c*horner π p := by
  induction p with
  | nil => simp only [List.map_nil,horner]; grind
  | cons a p ih => simp only [List.map_cons,horner,ih]; grind

theorem bounded_scale {B : F → Prop} (b : Subfield B) {π c x : F} {d : Nat}
    (hc : B c) (hx : Bounded B π d x) : Bounded B π d (c*x) := by
  obtain ⟨p,lp,hp,ex⟩ := hx
  refine ⟨p.map (fun a => c*a),by simpa using lp,?_,by rw [horner_scale,ex]⟩
  intro a ha
  obtain ⟨t,ht,rfl⟩ := List.mem_map.mp ha
  exact b.mul hc (hp _ ht)

/-- Every z^i=(1−π)^i has at most i+1 coefficients, built by multiplying
the previous polynomial by 1−π. -/
theorem power_in_shifted_basis {B : F → Prop} (b : Subfield B) (z : F) (i : Nat) :
    Bounded B (1-z) (i+1) (z^i) := by
  induction i with
  | zero => exact ⟨[1],by simp,by simpa using b.one,by simp only [horner,Semiring.pow_zero]; grind⟩
  | succ i ih =>
    obtain ⟨p,hp,cp,ep⟩ := ih
    have low : Bounded B (1-z) (i+1+1) (z^i) := ⟨p,by omega,cp,ep⟩
    have shifted : Bounded B (1-z) (i+1+1) ((1-z)*z^i) :=
      ⟨0::p,by simp; omega,fun c hc => (List.mem_cons.mp hc).elim (fun e => e ▸ b.zero) (cp c),
        by simp only [horner,ep]; grind⟩
    have h := bounded_add b low (bounded_scale b (b.neg b.one) shifted)
    rw [show z^i+ -(1:F)*((1-z)*z^i) = z^(i+1) by rw [Semiring.pow_succ]; grind] at h
    exact h

theorem subfield_pow {B : F → Prop} (b : Subfield B) {c : F} (hc : B c) (j : Nat) :
    B (c^j) := by
  induction j with
  | zero => simpa [Semiring.pow_zero] using b.one
  | succ j ih => simpa [Semiring.pow_succ] using b.mul ih hc

theorem reduce_power {z : F} {d : Nat} (hz : z^d = -1) (j : Nat) :
    z^j = (-1:F)^(j/d) * z^(j%d) := by
  have blocks (k : Nat) : z^(d*k) = (-1:F)^k := by
    induction k with
    | zero => simp [Semiring.pow_zero]
    | succ k ih => rw [Nat.mul_succ,Semiring.pow_add,ih,hz,Semiring.pow_succ]
  calc
    z^j = z^(j%d+d*(j/d)) := congrArg (fun v : Nat => z^v) (Nat.mod_add_div j d).symm
    _ = _ := by rw [Semiring.pow_add,blocks]; grind

theorem bounded_power {B : F → Prop} (b : Subfield B) {z : F} {d : Nat}
    (hd : 0<d) (hz : z^d= -1) (j : Nat) : Bounded B (1-z) d (z^j) := by
  obtain ⟨p,lp,cp,ep⟩ := power_in_shifted_basis b z (j%d)
  have r := Nat.mod_lt j hd
  have small : Bounded B (1-z) d (z^(j%d)) := ⟨p,by omega,cp,ep⟩
  rw [reduce_power hz j]
  exact bounded_scale b (subfield_pow b (b.neg b.one) _) small

/-- The polynomial ring generated by z over B, before forming fractions. -/
inductive PolynomialValue (B : F → Prop) (z : F) : F → Prop where
  | base {x} : B x → PolynomialValue B z x
  | shift {x} : PolynomialValue B z x → PolynomialValue B z (z*x)
  | plus {x y} : PolynomialValue B z x → PolynomialValue B z y → PolynomialValue B z (x+y)

theorem polynomial_scale {B : F → Prop} (b : Subfield B) {c z x : F}
    (hc : B c) (h : PolynomialValue B z x) : PolynomialValue B z (c*x) := by
  induction h with
  | base h => exact .base (b.mul hc h)
  | @shift x _ ih =>
    rw [show c*(z*x)=z*(c*x) by grind]
    exact .shift ih
  | @plus x y _ _ ih jh =>
    rw [show c*(x+y)=c*x+c*y by grind]
    exact .plus ih jh

theorem polynomial_product {B : F → Prop} (b : Subfield B) {z x y : F}
    (h : PolynomialValue B z x) (h' : PolynomialValue B z y) : PolynomialValue B z (x*y) := by
  induction h with
  | base hc => exact polynomial_scale b hc h'
  | @shift x _ ih =>
    rw [show (z*x)*y=z*(x*y) by grind]; exact .shift ih
  | @plus x t _ _ ih jh =>
    rw [show (x+t)*y=x*y+t*y by grind]; exact .plus ih jh

theorem polynomial_value_bounded {B : F → Prop} (b : Subfield B) {z x : F} {d : Nat}
    (hd : 0<d) (hz : z^d= -1) (h : PolynomialValue B z x) :
    ∀ j : Nat, Bounded B (1-z) d (z^j*x) := by
  induction h with
  | @base c hc =>
    intro j
    rw [CommSemiring.mul_comm]
    exact bounded_scale b hc (bounded_power b hd hz j)
  | @shift x _ ih =>
    intro j
    rw [show z^j*(z*x)=z^(j+1)*x by rw [Semiring.pow_succ]; grind]
    exact ih (j+1)
  | @plus x y _ _ ih jh =>
    intro j
    rw [show z^j*(x+y)=z^j*x+z^j*y by grind]
    exact bounded_add b (ih j) (jh j)

/-- The field generated using inverses has a polynomial numerator and a
nonzero polynomial denominator. The proof follows the field-expression
constructors and treats the totalized inverse of zero separately. -/
theorem generated_fraction {B : F → Prop} (b : Subfield B) {z x : F} (h : Generated B z x) :
    ∃ p q : F, PolynomialValue B z p ∧ PolynomialValue B z q ∧ q≠0 ∧ x*q=p := by
  have one : PolynomialValue B z 1 := .base b.one
  have nz : (1:F) ≠ 0 := fun h => Field.zero_ne_one h.symm
  have nzmul {u v : F} (hu : u≠0) (hv : v≠0) : u*v≠0 :=
    fun h => (Field.of_mul_eq_zero h).elim hu hv
  induction h with
  | @base x hx => exact ⟨x,1,.base hx,one,nz,Semiring.mul_one _⟩
  | gen => exact ⟨z*1,1,.shift one,one,nz,rfl⟩
  | @negative x _ ih =>
    obtain ⟨p,q,hp,hq,hz,he⟩ := ih
    exact ⟨(-1)*p,q,polynomial_scale b (b.neg b.one) hp,hq,hz,by grind⟩
  | @plus x y _ _ ih jh =>
    obtain ⟨p,q,hp,hq,hz,he⟩ := ih
    obtain ⟨t,s,ht,hs,hu,hy⟩ := jh
    exact ⟨p*s+t*q,q*s,.plus (polynomial_product b hp hs) (polynomial_product b ht hq),
      polynomial_product b hq hs,nzmul hz hu,by rw [← he,← hy]; grind⟩
  | @times x y _ _ ih jh =>
    obtain ⟨p,q,hp,hq,hz,he⟩ := ih
    obtain ⟨t,s,ht,hs,hu,hy⟩ := jh
    exact ⟨p*t,q*s,polynomial_product b hp ht,polynomial_product b hq hs,
      nzmul hz hu,by rw [← he,← hy]; grind⟩
  | @inverse x _ ih =>
    by_cases hx : x=0
    · rw [hx,Field.inv_zero]
      exact ⟨0,1,.base b.zero,one,nz,Semiring.mul_one _⟩
    · obtain ⟨p,q,hp,hq,hz,he⟩ := ih
      refine ⟨q,p,hq,hp,he ▸ nzmul hx hz,?_⟩
      rw [← he,← Semiring.mul_assoc,Field.inv_mul_cancel hx,Semiring.one_mul]

/-- Every element of B(z) has a bounded numerator and denominator in
π=1−z. No valuation, ramification, degree or linear independence assumption
is needed. -/
theorem cyclotomic_normal_form {B : F → Prop} (b : Subfield B) {z x : F} (n : Nat)
    (hz : z^(2^n : Nat) = -1) (hx : Generated B z x) :
    ∃ p q : List F, p.length ≤ 2^n ∧ q.length ≤ 2^n ∧
      (∀ c ∈ p, B c) ∧ (∀ c ∈ q, B c) ∧ horner (1-z) q ≠ 0 ∧
      x = horner (1-z) p / horner (1-z) q := by
  obtain ⟨u,v,hu,hv,hn,he⟩ := generated_fraction b hx
  have hd : 0 < 2^n := Nat.pow_pos (by decide)
  have pB : Bounded B (1-z) (2^n) u := by
    simpa [Semiring.pow_zero,Semiring.one_mul] using polynomial_value_bounded b hd hz hu 0
  have qB : Bounded B (1-z) (2^n) v := by
    simpa [Semiring.pow_zero,Semiring.one_mul] using polynomial_value_bounded b hd hz hv 0
  obtain ⟨p,lp,cp,ep⟩ := pB
  obtain ⟨q,lq,cq,eq⟩ := qB
  refine ⟨p,q,lp,lq,cp,cq,eq ▸ hn,?_⟩
  rw [ep,eq,Field.div_eq_mul_inv,← he,Semiring.mul_assoc,Field.mul_inv_cancel hn,Semiring.mul_one]

theorem generated_subfield {B : F → Prop} (b : Subfield B) (z : F) : Subfield (Generated B z) where
  zero := .base b.zero
  one := .base b.one
  add := Generated.plus
  neg := Generated.negative
  mul := Generated.times
  inv := Generated.inverse

/-- The expression predicate is the intersection of all subfields
containing B and z; it realizes the usual generated subfield. -/
theorem generated_iff_least {B : F → Prop} (b : Subfield B) (z x : F) :
    Generated B z x ↔ ∀ C : F → Prop, Subfield C → (∀ y, B y → C y) → C z → C x := by
  constructor
  · intro h C c inclus gen
    induction h with
    | base hx => exact inclus _ hx
    | gen => exact gen
    | plus _ _ ih jh => exact c.add ih jh
    | negative _ ih => exact c.neg ih
    | times _ _ ih jh => exact c.mul ih jh
    | inverse _ ih => exact c.inv ih
  · intro h
    exact h _ (generated_subfield b z) (fun _ hy => .base hy) .gen

end Reimann.DyadicCyclotomicSpan69
