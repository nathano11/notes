import Reimann.DyadicDecomposition69
import Reimann.DyadicRestrictionTower69
import Reimann.DyadicCyclotomicSpan69
import Reimann.DyadicEmbeddedBase69

/-! Relative decomposition in the field generated by all dyadic roots of unity. -/
namespace Reimann.DyadicLocalRestriction69

open Lean.Grind Reimann.DyadicDecomposition69

variable {F : Type} [Field F]

/-- Field automorphisms as bijective unital ring maps on the indicated field. -/
structure Automorphism (F : Type) [Field F] where
  app : F → F
  injective : Function.Injective app
  surjective : Function.Surjective app
  zero : app 0 = 0
  one : app 1 = 1
  add : ∀ x y, app (x+y) = app x + app y
  mul : ∀ x y, app (x*y) = app x * app y

theorem nonzero_image (g : Automorphism F) {x : F} (hx : x≠0) : g.app x≠0 :=
  fun h => hx (g.injective (h.trans g.zero.symm))

/-- Pull back a normalized valuation along an actual field automorphism. -/
def pull (V : DyadicValue F) (g : Automorphism F) : DyadicValue F where
  val x := V.val (g.app x)
  zero := by rw [g.zero,V.zero]
  two_ne := V.two_ne
  two := by
    have h : (2:F) = 1+1 := by grind only
    rw [h,g.add,g.one,←h,V.two]
  mul hx hy := by rw [g.mul,V.mul (nonzero_image g hx) (nonzero_image g hy)]
  smaller hx hy lt := by
    obtain ⟨hn,he⟩ := V.smaller (nonzero_image g hx) (nonzero_image g hy) lt
    refine ⟨?_,by rw [g.add,he]⟩
    intro h
    exact hn ((g.add _ _).symm.trans ((congrArg g.app h).trans g.zero))

/-- An element belongs to the valuation ideal if it is zero or has positive value. -/
def Supports (V : DyadicValue F) (x : F) : Prop := x=0 ∨ 0<V.val x

theorem stabilizes_ideal_of_isometry (V : DyadicValue F) (g : Automorphism F)
    (h : ∀ x, V.val (g.app x)=V.val x) (x : F) :
    Supports V (g.app x) ↔ Supports V x := by
  unfold Supports
  rw [h]
  exact or_congr ⟨fun e => g.injective (e.trans g.zero.symm),fun e => e ▸ g.zero⟩ Iff.rfl

theorem horner_agrees (u : F) (p : List F) :
    DyadicDecomposition69.horner u p = DyadicCyclotomicSpan69.horner u p := by
  induction p with
  | nil => rfl
  | cons c p ih => simp only [DyadicDecomposition69.horner,DyadicCyclotomicSpan69.horner,ih]

/-- Distinct fractional parts on bounded expansions determine the normalized place
on the whole simple extension, including quotients. -/
theorem generated_places_agree {B : F → Prop} (b : DyadicCyclotomicSpan69.Subfield B)
    (V W : DyadicValue F) (same : ∀ c, B c → AgreeIntegral V W c)
    (n : Nat) (z x : F) (hz : z^(2^n : Nat) = -1)
    (hx : DyadicCyclotomicSpan69.Generated B z x) : V.val x = W.val x := by
  obtain ⟨p,q,hp,hq,cp,cq,dn,eq⟩ := DyadicCyclotomicSpan69.cyclotomic_normal_form b n hz hx
  apply cyclotomic_place_unique V W n z x hz p q hp hq (fun c hc => same c (cp c hc))
    (fun c hc => same c (cq c hc))
  · rwa [horner_agrees]
  · rw [horner_agrees,horner_agrees,eq,Field.div_eq_mul_inv,Semiring.mul_assoc,
      Field.inv_mul_cancel dn,Semiring.mul_one]

/-- root n is a primitive root of order 2^(n+1). Every generator embeds in the next layer. -/
structure RootTower (F : Type) [Field F] where
  root : Nat → F
  half_order : ∀ n, root n ^ (2^n : Nat) = -1
  square : ∀ n, root (n+1) * root (n+1) = root n

theorem layer_succ {B : F → Prop} (b : DyadicCyclotomicSpan69.Subfield B)
    (C : RootTower F) {n : Nat} {x : F}
    (h : DyadicCyclotomicSpan69.Generated B (C.root n) x) :
    DyadicCyclotomicSpan69.Generated B (C.root (n+1)) x := by
  apply (DyadicCyclotomicSpan69.generated_iff_least b _ _).mp h _
    (DyadicCyclotomicSpan69.generated_subfield b _) (fun _ hx => .base hx)
  rw [← C.square n]
  exact .times .gen .gen

theorem layer_increasing {B : F → Prop} (b : DyadicCyclotomicSpan69.Subfield B)
    (C : RootTower F) {n m : Nat} (hnm : n ≤ m) {x : F}
    (hx : DyadicCyclotomicSpan69.Generated B (C.root n) x) :
    DyadicCyclotomicSpan69.Generated B (C.root m) x := by
  induction hnm with
  | refl => exact hx
  | step _ ih => exact layer_succ b C ih

theorem union_subfield {B : F → Prop} (b : DyadicCyclotomicSpan69.Subfield B)
    (C : RootTower F) :
    DyadicCyclotomicSpan69.Subfield (fun x => ∃ n, DyadicCyclotomicSpan69.Generated B (C.root n) x) where
  zero := ⟨0,.base b.zero⟩
  one := ⟨0,.base b.one⟩
  add := by
    rintro x y ⟨i,hi⟩ ⟨j,hj⟩
    exact ⟨max i j,.plus (layer_increasing b C (Nat.le_max_left i j) hi)
      (layer_increasing b C (Nat.le_max_right i j) hj)⟩
  mul := by
    rintro x y ⟨i,hi⟩ ⟨j,hj⟩
    exact ⟨max i j,.times (layer_increasing b C (Nat.le_max_left i j) hi)
      (layer_increasing b C (Nat.le_max_right i j) hj)⟩
  neg := by rintro x ⟨n,h⟩; exact ⟨n,.negative h⟩
  inv := by rintro x ⟨n,h⟩; exact ⟨n,.inverse h⟩

/-- The universal property of adjoining all roots is equivalent to membership
in a finite layer. -/
theorem generated_tower_iff_union {B : F → Prop} (b : DyadicCyclotomicSpan69.Subfield B)
    (C : RootTower F) (x : F) :
    (∀ S : F → Prop, DyadicCyclotomicSpan69.Subfield S → (∀ y, B y → S y) →
      (∀ n, S (C.root n)) → S x) ↔ ∃ n, DyadicCyclotomicSpan69.Generated B (C.root n) x := by
  constructor
  · intro h
    exact h _ (union_subfield b C) (fun _ hy => ⟨0,.base hy⟩) (fun n => ⟨n,.gen⟩)
  · rintro ⟨n,hn⟩ S hs hb hz
    exact (DyadicCyclotomicSpan69.generated_iff_least b _ _).mp hn S hs hb (hz n)

/-- The real generator at index a is ζ_(2^(a+2)) + ζ_(2^(a+2))⁻¹. -/
def FixesRealLayer (B : F → Prop) (C : RootTower F) (a : Nat) (g : Automorphism F) : Prop :=
  ∀ x, DyadicCyclotomicSpan69.Generated B (C.root (a+1) + (C.root (a+1))⁻¹) x → g.app x=x

/-- The ambient field is generated by B and all the specified roots. -/
def GeneratesField (B : F → Prop) (C : RootTower F) : Prop :=
  ∀ (S : F → Prop), DyadicCyclotomicSpan69.Subfield S → (∀ y, B y → S y) →
    (∀ n, S (C.root n)) → ∀ x, S x

/-- At either actual prime of Q(√−3,√−23), the center alone determines
the value on the whole finite cyclotomic compositum. -/
theorem finite_layer_place_unique (f : DyadicBottomValue69.Embedding F) (i : Bool)
    (V W : DyadicValue F) (hV : DyadicBottomValue69.Centered f V i)
    (hW : DyadicBottomValue69.Centered f W i) (n : Nat) {z x : F}
    (hz : z^(2^n : Nat) = -1)
    (hx : DyadicCyclotomicSpan69.Generated (DyadicEmbeddedBase69.baseImage f) z x) :
    V.val x = W.val x := by
  apply generated_places_agree (DyadicEmbeddedBase69.base_subfield f) V W _ n z x hz hx
  rintro c ⟨y,rfl⟩
  exact DyadicBottomValue69.agree_integral_on_bottom f V W i hV hW y

theorem pull_centered (f : DyadicBottomValue69.Embedding F) (i : Bool)
    (V : DyadicValue F) (hV : DyadicBottomValue69.Centered f V i) (g : Automorphism F)
    (fixes : ∀ z, g.app (f.app z)=f.app z) : DyadicBottomValue69.Centered f (pull V g) i where
  nonneg x := by change 0 ≤ V.val (g.app (f.app x.val)); rw [fixes]; exact hV.nonneg x
  center x := by change _ ↔ _ ∨ 0 < V.val (g.app (f.app x.val)); rw [fixes]; exact hV.center x

/-- The center determines the normalized valuation on L=E₀(μ₂∞). -/
theorem infinite_layer_place_unique (f : DyadicBottomValue69.Embedding F) (C : RootTower F)
    (hL : GeneratesField (DyadicEmbeddedBase69.baseImage f) C) (i : Bool)
    (V W : DyadicValue F) (hV : DyadicBottomValue69.Centered f V i)
    (hW : DyadicBottomValue69.Centered f W i) : V=W := by
  have vals (x : F) : V.val x = W.val x := by
    obtain ⟨n,hn⟩ := (generated_tower_iff_union (DyadicEmbeddedBase69.base_subfield f) C x).mp
      (fun S hs hb hz => hL S hs hb hz x)
    exact finite_layer_place_unique f i V W hV hW n (C.half_order n) hn
  cases V
  cases W
  congr
  exact funext vals

/-- Every Eₐ-automorphism of L preserves the normalized value at each
of the two labeled dyadic places of E₀, for every a. -/
theorem relative_isometry (f : DyadicBottomValue69.Embedding F) (C : RootTower F)
    (hL : GeneratesField (DyadicEmbeddedBase69.baseImage f) C) (i : Bool)
    (V : DyadicValue F) (hV : DyadicBottomValue69.Centered f V i)
    (a : Nat) (g : Automorphism F) (hg : FixesRealLayer (DyadicEmbeddedBase69.baseImage f) C a g)
    (x : F) : V.val (g.app x)=V.val x := by
  have hfix z := hg (f.app z) (.base ⟨z,rfl⟩)
  have eq := infinite_layer_place_unique f C hL i (pull V g) V (pull_centered f i V hV g hfix) hV
  exact congrArg (fun (W : DyadicValue F) => W.val x) eq

/-- The inclusion of the relative decomposition subgroup into Gal(L/Eₐ)
is surjective at both bottom prime labels. -/
theorem relative_decomposition_surjective (f : DyadicBottomValue69.Embedding F) (C : RootTower F)
    (hL : GeneratesField (DyadicEmbeddedBase69.baseImage f) C) (i : Bool)
    (V : DyadicValue F) (hV : DyadicBottomValue69.Centered f V i) (a : Nat) :
    let U := {g : Automorphism F // FixesRealLayer (DyadicEmbeddedBase69.baseImage f) C a g}
    Function.Surjective (fun d : {g : U // ∀ x, Supports V (g.val.app x) ↔ Supports V x} => d.val) := by
  intro U g
  exact ⟨⟨g,stabilizes_ideal_of_isometry V g.val (relative_isometry f C hL i V hV a g.val g.property)⟩,rfl⟩

/-- Given the absolute Galois realization, ordinary extension of field automorphisms
and transitivity of the kernel on prolongations give surjectivity of the absolute
decomposition map. No local surjectivity or finite-place uniqueness is assumed. -/
theorem absolute_decomposition_surjective {G U W : Type}
    {H : Transfer.GroupLaw G} {Q : Transfer.GroupLaw U}
    (f : DyadicBottomValue69.Embedding F) (C : RootTower F)
    (hL : GeneratesField (DyadicEmbeddedBase69.baseImage f) C)
    (a : Nat) (i : Bool) (res : Transfer.Hom H Q)
    (A : DyadicRestrictionTower69.PlaceAction H W)
    (R : DyadicRestrictionTower69.PlaceAction Q (DyadicValue F))
    (below : W → DyadicValue F) (p : W) (hp : DyadicBottomValue69.Centered f (below p) i)
    (autos : U → Automorphism F)
    (fixes : ∀ t, FixesRealLayer (DyadicEmbeddedBase69.baseImage f) C a (autos t))
    (action_on_value : ∀ t, R.move t (below p) = pull (below p) (autos (Q.neg t)))
    (equivariant : ∀ g w, below (A.move g w)=R.move (res.app g) (below w))
    (extend : ∀ t, ∃ g, res.app g=t)
    (transitive : ∀ w, below w=below p → ∃ k, res.app k=Q.zero ∧ A.move k w=p)
    (t : U) : ∃ g : G, res.app g=t ∧ A.move g p=p := by
  apply (DyadicRestrictionTower69.decomposition_image_iff res A R below p equivariant extend transitive t).mpr
  rw [action_on_value]
  exact infinite_layer_place_unique f C hL i _ _ (pull_centered f i _ hp _
    (fun z => fixes (Q.neg t) _ (.base ⟨z,rfl⟩))) hp

end Reimann.DyadicLocalRestriction69
