import Reimann.DyadicMahler69

/-! One-sided divisibility for the canonical inverse-exponent series of conductor 69.
Only the first three coefficients survive modulo (8,T³). -/
namespace Reimann.DyadicOneSided69

open Reimann.DyadicLattice Reimann.DyadicOrder Reimann.DyadicSeriesProjection
open Reimann.DyadicMahler69

/-- P belongs to the ideal generated by Φ in (ℤ/8)[T]/(T³), whose
three coefficients use the checked Φ residues (4,6,1). -/
def ForwardJet (c0 c1 : Scalar) : Prop :=
  ∃ a b c : BitVec 3, c0.residue 2 = a*4 ∧ c1.residue 2 = a*6+b*4 ∧
    (1 : BitVec 3) = a+(b*6+c*4)

theorem canonical_jet :
    (series 0).residue 2 = 4 ∧ (series 1).residue 2 = 6 ∧ (series 2).residue 2 = 1 := by
  obtain ⟨h0,h⟩ := Prod.mk.inj first_four_residues
  obtain ⟨h1,h⟩ := Prod.mk.inj h
  exact ⟨h0,h1,(Prod.mk.inj h).1⟩

theorem forward_jet_of_divisibility {c0 c1 : Scalar}
    (h : ∃ u : Series, quadraticSeries c0 c1 = convolution u series) : ForwardJet c0 c1 := by
  obtain ⟨u,hu⟩ := h
  obtain ⟨p0,p1,p2⟩ := canonical_jet
  have atDegree (k : Nat) := congrArg (fun f : Series => (f k).residue 2) hu
  have h0 : c0.residue 2 = (convolution u series 0).residue 2 := atDegree 0
  have h1 : c1.residue 2 = (convolution u series 1).residue 2 := atDegree 1
  have h2 : (1 : BitVec 3) = (convolution u series 2).residue 2 := atDegree 2
  rw [convolution_zero,p0] at h0
  rw [convolution_one,p1,p0] at h1
  rw [convolution_two,p2,p1,p0] at h2
  exact ⟨(u 0).residue 2,(u 1).residue 2,(u 2).residue 2,h0,h1,by grind⟩

/-- Monicity forces the constant coefficient of the multiplier to be odd.
It simultaneously fixes the scaled zeroth and first coefficients modulo 8. -/
theorem monic_multiplier (a b c : BitVec 3) (h : 1 = a+(b*6+c*4)) :
    a.setWidth 1 = 1 ∧ a*4 = 4 ∧ a*6+b*4 = 6 :=
  (by decide : ∀ a b c : BitVec 3, 1 = a+(b*6+c*4) →
    a.setWidth 1 = 1 ∧ a*4 = 4 ∧ a*6+b*4 = 6) a b c h

theorem forward_jet_iff (c0 c1 : Scalar) :
    ForwardJet c0 c1 ↔ c0.residue 2 = 4 ∧ c1.residue 2 = 6 := by
  constructor
  · rintro ⟨a,b,c,h0,h1,h2⟩
    obtain ⟨_,z,l⟩ := monic_multiplier a b c h2
    exact ⟨h0.trans z,h1.trans l⟩
  · rintro ⟨h0,h1⟩
    exact ⟨1,0,0,h0,h1,by decide⟩

theorem samples_of_forward_jet {c0 c1 : Scalar} (h : ForwardJet c0 c1) :
    WeightOneSamples c0 c1 := by
  obtain ⟨h0,h1⟩ := (forward_jet_iff c0 c1).mp h
  apply Reimann.DyadicClass69.sample_bits_of_coefficients _ _ h0
  rw [← c1.reduce (by decide : 1 ≤ 2),h1]
  decide

/-- P belongs to the ideal of Φ in Λ/(2,T)³ with Λ = ℤ₂[[T]].
The coefficient precisions in orders 0,1,2 are respectively 8,4,2.
The three words represent arbitrary coefficients of the multiplier. -/
def WeightedJet (c0 c1 : Scalar) : Prop :=
  ∃ a b c : BitVec 3, (c0.residue 2,c1.residue 1,(1 : BitVec 1)) =
    (a*4,(a*6+b*4).setWidth 2,(a+(b*6+c*4)).setWidth 1)

/-- Since Φ lies in (2,T)², its product modulo (2,T)³ depends only on
the parity of the constant term of the multiplier. -/
theorem weighted_product (a b c : BitVec 3) :
    (a*4,(a*6+b*4).setWidth 2,(a+(b*6+c*4)).setWidth 1) =
      if a.setWidth 1 = 1 then (4,2,1) else (0,0,0) :=
  (by decide : ∀ a b c : BitVec 3,
    (a*4,(a*6+b*4).setWidth 2,(a+(b*6+c*4)).setWidth 1) =
      if a.setWidth 1 = 1 then (4,2,1) else (0,0,0)) a b c

theorem weighted_jet_iff_samples (c0 c1 : Scalar) :
    WeightedJet c0 c1 ↔ WeightOneSamples c0 c1 := by
  constructor
  · rintro ⟨a,b,c,h⟩
    rw [weighted_product] at h
    split at h
    · obtain ⟨h0,h⟩ := Prod.mk.inj h
      exact Reimann.DyadicClass69.sample_bits_of_coefficients _ _ h0 (Prod.mk.inj h).1
    · have hz := (Prod.mk.inj (Prod.mk.inj h).2).2
      exact False.elim ((by decide : (1 : BitVec 1) ≠ 0) hz)
  · intro h
    obtain ⟨h0,h1⟩ := moment_coefficient_bits h
    refine ⟨1,0,0,?_⟩
    rw [h0,h1]
    decide

theorem samples_of_forward_divisibility {c0 c1 : Scalar}
    (h : ∃ u : Series, quadraticSeries c0 c1 = convolution u series) : WeightOneSamples c0 c1 :=
  samples_of_forward_jet (forward_jet_of_divisibility h)

theorem lattice_order_of_weighted_jet {c0 c1 : Scalar}
    (h : WeightedJet c0 c1) (r a : Nat) :
    ∃ encode : Quot (latticeCoset c0 c1 r a) → Fin (2^(2*a+1)),
    ∃ decode : Fin (2^(2*a+1)) → Quot (latticeCoset c0 c1 r a),
      (∀ x, decode (encode x) = x) ∧ (∀ i, encode (decode i) = i) :=
  lattice_order_of_weight_one_samples ((weighted_jet_iff_samples c0 c1).mp h) r a

theorem lattice_order_of_forward_divisibility {c0 c1 : Scalar}
    (h : ∃ u : Series, quadraticSeries c0 c1 = convolution u series) (r a : Nat) :
    ∃ encode : Quot (latticeCoset c0 c1 r a) → Fin (2^(2*a+1)),
    ∃ decode : Fin (2^(2*a+1)) → Quot (latticeCoset c0 c1 r a),
      (∀ x, decode (encode x) = x) ∧ (∀ i, encode (decode i) = i) :=
  lattice_order_of_weight_one_samples (samples_of_forward_divisibility h) r a

/-- For a distinguished monic P the opposite inclusion in (ℤ/8)[T]/(T³)
also forces the same two coefficients. -/
theorem distinguished_reverse_jet (x y a b c : BitVec 3)
    (hx : x.setWidth 1 = 0) (hy : y.setWidth 1 = 0)
    (h0 : 4 = a*x) (h1 : 6 = a*y+b*x) (h2 : 1 = a+(b*y+c*x)) :
    x = 4 ∧ y = 6 :=
  (by decide : ∀ x y a b c : BitVec 3, x.setWidth 1 = 0 → y.setWidth 1 = 0 →
    4 = a*x → 6 = a*y+b*x → 1 = a+(b*y+c*x) → x = 4 ∧ y = 6)
      x y a b c hx hy h0 h1 h2

theorem samples_of_reverse_divisibility {c0 c1 : Scalar}
    (even0 : c0.residue 0 = 0) (even1 : c1.residue 0 = 0)
    (h : ∃ u : Series, series = convolution u (quadraticSeries c0 c1)) :
    WeightOneSamples c0 c1 := by
  obtain ⟨u,hu⟩ := h
  obtain ⟨p0,p1,p2⟩ := canonical_jet
  have atDegree (k : Nat) := congrArg (fun f : Series => (f k).residue 2) hu
  have h0 := p0.symm.trans (atDegree 0)
  have h1 := p1.symm.trans (atDegree 1)
  have h2 := p2.symm.trans (atDegree 2)
  rw [convolution_zero] at h0
  rw [convolution_one] at h1
  rw [convolution_two] at h2
  change (1 : BitVec 3) = (u 0).residue 2*1+((u 1).residue 2*c1.residue 2+(u 2).residue 2*c0.residue 2) at h2
  have hcoef := distinguished_reverse_jet (c0.residue 2) (c1.residue 2)
    ((u 0).residue 2) ((u 1).residue 2) ((u 2).residue 2)
    ((c0.reduce (by decide : 0 ≤ 2)).trans even0) ((c1.reduce (by decide : 0 ≤ 2)).trans even1)
    h0 h1 (by grind)
  exact samples_of_forward_jet ((forward_jet_iff c0 c1).mpr hcoef)

theorem lattice_order_of_reverse_divisibility {c0 c1 : Scalar}
    (even0 : c0.residue 0 = 0) (even1 : c1.residue 0 = 0)
    (h : ∃ u : Series, series = convolution u (quadraticSeries c0 c1)) (r a : Nat) :
    ∃ encode : Quot (latticeCoset c0 c1 r a) → Fin (2^(2*a+1)),
    ∃ decode : Fin (2^(2*a+1)) → Quot (latticeCoset c0 c1 r a),
      (∀ x, decode (encode x) = x) ∧ (∀ i, encode (decode i) = i) :=
  lattice_order_of_weight_one_samples (samples_of_reverse_divisibility even0 even1 h) r a

end Reimann.DyadicOneSided69
