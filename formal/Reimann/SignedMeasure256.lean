import Reimann.Character2893

/-! Finite coefficients for the even quadratic character of conductor 2893 on
the quotient generated by 5 modulo 256. The j-th exponent uses the residue
of the inverse power of 5. The signed moment identity below is integral,
including the factor 2893 before division. -/

namespace Reimann.SignedMeasure256

/-- Coefficients in ascending powers of the generator. -/
def row : List Int :=
  [-8,-2,22,-35,40,1,-19,-21,15,-26,1,-3,-11,7,3,-9,
   -2,-5,-19,-6,-10,27,-7,0,16,-16,5,4,10,20,3,8,
   -1,2,-6,4,-2,-16,17,0,-28,18,12,15,15,-26,-9,33,
   15,10,9,7,6,-1,26,4,-13,15,-33,-7,-17,-6,-6,-12]

/-- 205 is the least nonnegative inverse of 5 modulo 256. -/
def inverseResidue (j : Nat) : Nat := 205^j % 256

/-- Every exponent in the row labels a residue congruent to 1 modulo 4,
inverse to the indicated generator power. -/
theorem inverse_index (j : Fin 64) :
    (5^j.val * inverseResidue j.val) % 256 = 1 ∧ inverseResidue j.val % 4 = 1 := by
  revert j
  decide

/-- The unnormalized coefficient is the negative first character moment
over one full conductor. -/
def numerator (t : Nat) : Int :=
  (List.range 2893).foldl (fun acc h =>
    let a := t + 256*h
    acc - (h:Int) * Reimann.Dyadic.quadSymbol 11 a * Reimann.Dyadic.quadSymbol 263 a) 0

/-- Integral evaluation of the coefficient polynomial. -/
def value (x : Int) : Int := row.foldr (fun c acc => c + x * acc) 0

theorem weight_three_arguments : (125 * 213 : Nat) % 256 = 1 ∧ (-213 : Int) % 256 = 43 := by
  decide

set_option maxRecDepth 8192 in
theorem signed_residues : value 213 % 256 = 160 ∧ value 43 % 256 = 128 := by
  decide

/-- The residue pair is independently obtained from the normalized Bernoulli sums. -/
theorem equals_normalized_moments :
    value 213 % 256 =
      (Character2893.sums.weightThree / (240*(Character2893.modulus : Int))) % 256 ∧
    value 43 % 256 =
      (Character2893.sums.twistedThree / (240*(Character2893.modulus : Int))) % 256 := by
  rw [signed_residues.1, signed_residues.2, Character2893.normalized_table,
    Character2893.modulus_value]
  decide

theorem row_length : row.length = 64 := by decide

/-- Enumerate both lifts of each Gamma-index to the unit group modulo 256. -/
def signedIndices : List Nat :=
  (List.range 64).flatMap (fun j => [inverseResidue j, (256 - inverseResidue j) % 256])

set_option maxRecDepth 4096 in
/-- Each odd residue occurs exactly once, and even residues occur zero times. -/
theorem signed_coverage (t : Fin 256) : signedIndices.count t.val = t.val % 2 := by
  revert t
  decide

/-- Conductor character before restriction to a residue class modulo 256. -/
def character (a : Nat) : Int :=
  Reimann.Dyadic.quadSymbol 11 a * Reimann.Dyadic.quadSymbol 263 a

theorem character_congr {a b : Nat} (h : a % 11 = b % 11) (k : a % 263 = b % 263) :
    character a = character b := by
  simp only [character, Reimann.Dyadic.quadSymbol, h, k]

/-- Sum a consecutive block, starting at t and ending before t+n. -/
def blockSum (g : Nat → Int) (t : Nat) : Nat → Int
  | 0 => 0
  | n+1 => blockSum g t n + g (t+n)

theorem block_shift (g : Nat → Int) (t n : Nat) :
    blockSum g (t+1) n = blockSum g t n - g t + g (t+n) := by
  induction n with
  | zero => simp only [blockSum, Nat.add_zero]; omega
  | succ n ih =>
    simp only [blockSum, ih, show t+1+n = t+(n+1) by omega]
    omega

theorem periodic_block (g : Nat → Int) (n : Nat) (period : ∀ h, g (h+n) = g h) (t : Nat) :
    blockSum g t n = blockSum g 0 n := by
  induction t with
  | zero => rfl
  | succ t ih => rw [block_shift, period, ih]; omega

theorem translate_block (g : Nat → Int) (t n : Nat) :
    blockSum (fun h => g (t+h)) 0 n = blockSum g t n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [blockSum, ih, Nat.zero_add]

/-- Sum of the character values before the h-weight is inserted. -/
def mass (t : Nat) : Int := blockSum (fun h => character (t + 256*h)) 0 2893

theorem mass_independent (t : Nat) : mass t = mass 0 := by
  let g := fun h => character (256*h)
  have shifted : (fun h => character (t+256*h)) = (fun h => g (1390*t+h)) := by
    funext h
    apply character_congr <;> omega
  have period : ∀ h, g (h+2893) = g h := by
    intro h
    apply character_congr <;> omega
  unfold mass
  rw [shifted, translate_block, periodic_block g 2893 period (1390*t)]
  simp only [g, Nat.zero_add]

set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
set_option exponentiation.threshold 300 in
theorem mass_zero (t : Nat) : mass t = 0 := by
  rw [mass_independent]
  decide

set_option maxRecDepth 131072 in
set_option maxHeartbeats 0 in
set_option exponentiation.threshold 300 in
/-- Equality before division proves exact integrality of every listed coefficient. -/
theorem row_coefficients (j : Fin 64) :
    numerator (inverseResidue j.val) = 2893 * row[j.val]! := by
  revert j
  decide

end Reimann.SignedMeasure256
