import Reimann.SignedMeasure
import Reimann.SignedMeasure256

/-! Integral pushforward of four equal-length coefficient blocks in the
finite quotients generated by 5. The polynomial variable is X=1+T. -/
namespace Reimann.SignedRowDescent

/-- Under X^n = 1 the four coefficients with index congruent to j
modulo n contribute to a single coefficient. Used on rows of length 4*n. -/
def pushFour (n : Nat) (a : List Int) : List Int :=
  (List.range n).map (fun j =>
    a[j]?.getD 0 + a[j+n]?.getD 0 + a[j+2*n]?.getD 0 + a[j+3*n]?.getD 0)

theorem four_terms (c0 c1 c2 c3 x : Int) (n j : Nat) (hx : x^n = 1) :
    c0*x^j + c1*x^(j+n) + c2*x^(j+2*n) + c3*x^(j+3*n) =
    (c0+c1+c2+c3)*x^j := by
  rw [Nat.mul_comm 2 n, Nat.mul_comm 3 n]
  simp only [Int.pow_add, Int.pow_mul, hx, Int.one_pow, Int.mul_one]
  grind

/-- Exponents differing by 16 index the same inverse-generator residue
after reducing 256 to 64. -/
theorem indices_256_to_64 : ∀ j : Fin 64,
    SignedMeasure256.inverseResidue j.val % 64 = SignedMeasure.representative (j.val % 16) := by
  decide

theorem level256_pushes_to_level64 :
    SignedMeasure256.row.length = 64 ∧ pushFour 16 SignedMeasure256.row = SignedMeasure.row := by
  decide

/-- Coefficients on the quotient of order four, with the same inverse
generator indexing as at 64 and 256. -/
def orderFour : List Int := [25, 2, -1, -18]

theorem level64_pushes_to_order_four :
    SignedMeasure.row.length = 16 ∧ pushFour 4 SignedMeasure.row = orderFour := by decide

theorem order_four_mod_two :
    orderFour.map (fun c => c % 2) = [1, 0, 1, 0] := by decide

/-- The integral correction exhibits 1+X²=(X-1)² modulo 2 as a polynomial. -/
theorem square_mod_two (x : Int) :
    SignedMeasure.evaluate orderFour x =
      (x-1)^2 + 2*(12+2*x-x^2-9*x^3) := by
  simp only [SignedMeasure.evaluate, orderFour, List.foldr_cons, List.foldr_nil]
  grind

/-- Integral coefficients in T=X−1. -/
def translated : List Int := [8, -54, -55, -18]

theorem expansion_at_one (t : Int) :
    SignedMeasure.evaluate orderFour (1+t) = SignedMeasure.evaluate translated t := by
  simp only [SignedMeasure.evaluate, orderFour, translated, List.foldr_cons, List.foldr_nil]
  grind

/-- The lowest surviving coefficient is the quadratic one. -/
theorem quadratic_initial_term :
    translated.map (fun c => c % 2) = [0, 0, 1, 0] := by decide

/-- The group relation X⁴=1 reduces in the T-coordinate to T⁴=0
in characteristic two. -/
theorem group_relation_in_t (t : Int) :
    (1+t)^4-1 = t^4 + 2*(2*t+3*t^2+2*t^3) := by grind

/-- Any coefficient sequence specializing to the verified low four bits
has its first odd coefficient in degree two. Identifying such a sequence
with the infinite arithmetic series is a separate input. -/
theorem first_odd_coefficient (a : Nat → Int)
    (projection : ∀ j : Fin 4, a j % 2 = translated[j.val]! % 2) :
    (∀ i < 2, a i % 2 = 0) ∧ a 2 % 2 = 1 := by
  have h0 := projection 0
  have h1 := projection 1
  have h2 := projection 2
  change a 0 % 2 = 0 at h0
  change a 1 % 2 = 0 at h1
  change a 2 % 2 = 1 at h2
  refine ⟨?_, h2⟩
  intro i hi
  rcases (show i = 0 ∨ i = 1 by omega) with rfl | rfl
  · exact h0
  · exact h1

end Reimann.SignedRowDescent
