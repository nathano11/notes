import Reimann.TameBiquadratic277

namespace Reimann.TameOrderReduction277

open TameBiquadratic277 Lean.Grind Fin.IntCast

/-- Coefficient reduction on the order in the basis 1, X, Y, XY. -/
def reduce (n : Nat) (z : Quad Int) : Quad (Residue n) :=
  ((z.1.1,z.1.2),(z.2.1,z.2.2))

/-- Canonical (nonnegative) integer lifts of the four coefficients. -/
def lift (n : Nat) (x : Quad (Residue n)) : Quad Int :=
  ((x.1.1.val,x.1.2.val),(x.2.1.val,x.2.2.val))

theorem cast_val {n : Nat} (x : Residue n) : ((x.val : Int) : Residue n) = x := by
  apply Fin.eq_of_val_eq
  rw [Lean.Grind.Fin.val_intCast]
  have hx : (x.val : Int) < (277^(n+1) : Nat) := Int.ofNat_lt.mpr x.isLt
  rw [Int.emod_eq_of_lt (by omega) hx]
  simp

theorem reduce_lift (n : Nat) (x : Quad (Residue n)) : reduce n (lift n x) = x := by
  apply Prod.ext <;> apply Prod.ext <;> exact cast_val _

theorem reduce_add (n : Nat) (x y : Quad Int) :
    reduce n (componentAdd x y) = componentAdd (reduce n x) (reduce n y) := by
  apply Prod.ext <;> apply Prod.ext <;> simp only [reduce, componentAdd, Ring.intCast_add]

theorem reduce_product (n : Nat) (x y : Quad Int) :
    reduce n (product (-3) (-23) x y) = product (-3) (-23) (reduce n x) (reduce n y) := by
  rcases x with ⟨⟨a,b⟩,⟨c,d⟩⟩
  rcases y with ⟨⟨e,f⟩,⟨g,h⟩⟩
  simp only [reduce, product, Ring.intCast_add, Ring.intCast_mul, Ring.intCast_neg]
  grind

def scale (k : Int) (z : Quad Int) : Quad Int :=
  ((k*z.1.1,k*z.1.2),(k*z.2.1,k*z.2.2))

theorem cast_eq_iff (n : Nat) (a b : Int) :
    (a : Residue n) = (b : Residue n) ↔ (277 : Int)^(n+1) ∣ a-b := by
  constructor
  · intro h
    have he := congrArg (fun z : Residue n => (z.val : Int)) h
    simp only [Lean.Grind.Fin.val_intCast] at he
    have hm : ((277^(n+1) : Nat) : Int) ≠ 0 := by
      exact Int.ofNat_ne_zero.mpr (Nat.ne_of_gt (Nat.pow_pos (by decide)))
    rw [Int.toNat_of_nonneg (Int.emod_nonneg _ hm), Int.toNat_of_nonneg (Int.emod_nonneg _ hm)] at he
    exact Int.dvd_of_emod_eq_zero (Int.emod_eq_emod_iff_emod_sub_eq_zero.mp he)
  · exact cast_difference _ _

/-- The congruence kernel is exactly the ideal generated by the modulus
in the integral polynomial order. -/
theorem reduce_eq_iff (n : Nat) (z v : Quad Int) :
    reduce n z = reduce n v ↔ ∃ u : Quad Int, z = componentAdd v (scale (277^(n+1)) u) := by
  let m : Int := 277^(n+1)
  constructor
  · intro h
    obtain ⟨a,ha⟩ := (cast_eq_iff n z.1.1 v.1.1).mp (congrArg (fun x => x.1.1) h)
    obtain ⟨b,hb⟩ := (cast_eq_iff n z.1.2 v.1.2).mp (congrArg (fun x => x.1.2) h)
    obtain ⟨c,hc⟩ := (cast_eq_iff n z.2.1 v.2.1).mp (congrArg (fun x => x.2.1) h)
    obtain ⟨d,hd⟩ := (cast_eq_iff n z.2.2 v.2.2).mp (congrArg (fun x => x.2.2) h)
    refine ⟨((a,b),(c,d)),?_⟩
    apply Prod.ext <;> apply Prod.ext <;> simp only [componentAdd,scale] <;> omega
  · rintro ⟨u,rfl⟩
    have one (x y : Int) : ((x+m*y : Int) : Residue n) = (x : Residue n) :=
      (cast_eq_iff n _ _).mpr ⟨y,by dsimp [m]; grind⟩
    apply Prod.ext <;> apply Prod.ext <;> exact one _ _

end Reimann.TameOrderReduction277
